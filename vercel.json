{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</.well-known/api-catalog>; rel=\"api-catalog\", </openapi.json>; rel=\"service-desc\"; type=\"application/json\", </desenvolvedores>; rel=\"service-doc\", </llms.txt>; rel=\"describedby\", </.well-known/ai-catalog.json>; rel=\"ai-catalog\", </.well-known/mcp/server-card.json>; rel=\"alternate\"; type=\"application/json\""
        }
      ]
    },
    {
      "source": "/.well-known/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/api-catalog",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/linkset+json; profile=\"https://www.rfc-editor.org/info/rfc9727\""
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Link",
          "value": "</.well-known/api-catalog>; rel=\"api-catalog\""
        }
      ]
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/openid-configuration",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/ai-catalog.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/mcp",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, HEAD, OPTIONS"
        }
      ]
    },
    {
      "source": "/:caminho*.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*\\.vercel\\.app)"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/about",
      "destination": "/sobre"
    },
    {
      "source": "/contact",
      "destination": "/contato"
    },
    {
      "source": "/privacy",
      "destination": "/privacidade"
    },
    {
      "source": "/uses",
      "destination": "/usos"
    },
    {
      "source": "/developers",
      "destination": "/desenvolvedores"
    },
    {
      "source": "/docs",
      "destination": "/desenvolvedores"
    },
    {
      "source": "/developer",
      "destination": "/desenvolvedores"
    },
    {
      "source": "/api-docs",
      "destination": "/desenvolvedores"
    }
  ],
  "redirects": [
    {
      "source": "/projects",
      "destination": "/#projetos",
      "statusCode": 301
    },
    {
      "source": "/projetos",
      "destination": "/#projetos",
      "statusCode": 301
    },
    {
      "source": "/projects/:slug",
      "destination": "/#projetos",
      "statusCode": 301
    },
    {
      "source": "/projetos/:slug",
      "destination": "/#projetos",
      "statusCode": 301
    },
    {
      "source": "/services",
      "destination": "/sobre",
      "statusCode": 301
    },
    {
      "source": "/servicos",
      "destination": "/sobre",
      "statusCode": 301
    },
    {
      "source": "/blog",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/blog/:slug*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/en",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/en/:caminho*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/pt",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/pt/:caminho*",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/home",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/index",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/stack",
      "destination": "/usos",
      "statusCode": 301
    },
    {
      "source": "/skills",
      "destination": "/usos",
      "statusCode": 301
    },
    {
      "source": "/experience",
      "destination": "/#experiencia",
      "statusCode": 301
    },
    {
      "source": "/experiencia",
      "destination": "/#experiencia",
      "statusCode": 301
    },
    {
      "source": "/resume",
      "destination": "/Curriculo-LucasCavalheri.pdf",
      "statusCode": 301
    },
    {
      "source": "/cv",
      "destination": "/Curriculo-LucasCavalheri.pdf",
      "statusCode": 301
    },
    {
      "source": "/curriculo",
      "destination": "/Curriculo-LucasCavalheri.pdf",
      "statusCode": 301
    }
  ]
}
