{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/:caminho*.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/about",
      "destination": "/sobre"
    },
    {
      "source": "/contact",
      "destination": "/contato"
    },
    {
      "source": "/privacy",
      "destination": "/privacidade"
    },
    {
      "source": "/uses",
      "destination": "/usos"
    },
    {
      "source": "/developers",
      "destination": "/desenvolvedores"
    },
    {
      "source": "/docs",
      "destination": "/desenvolvedores"
    },
    {
      "source": "/developer",
      "destination": "/desenvolvedores"
    },
    {
      "source": "/api-docs",
      "destination": "/desenvolvedores"
    }
  ]
}
