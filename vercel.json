{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/:caminho*.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(.*\\.vercel\\.app)"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/about",
      "destination": "/sobre"
    },
    {
      "source": "/contact",
      "destination": "/contato"
    },
    {
      "source": "/privacy",
      "destination": "/privacidade"
    },
    {
      "source": "/uses",
      "destination": "/usos"
    },
    {
      "source": "/developers",
      "destination": "/desenvolvedores"
    },
    {
      "source": "/docs",
      "destination": "/desenvolvedores"
    },
    {
      "source": "/developer",
      "destination": "/desenvolvedores"
    },
    {
      "source": "/api-docs",
      "destination": "/desenvolvedores"
    }
  ],
  "redirects": [
    {
      "source": "/projects",
      "destination": "/#projetos",
      "permanent": true
    },
    {
      "source": "/projetos",
      "destination": "/#projetos",
      "permanent": true
    },
    {
      "source": "/projects/:slug",
      "destination": "/#projetos",
      "permanent": true
    },
    {
      "source": "/projetos/:slug",
      "destination": "/#projetos",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/sobre",
      "permanent": true
    },
    {
      "source": "/servicos",
      "destination": "/sobre",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/blog/:slug*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/:caminho*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pt",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pt/:caminho*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/stack",
      "destination": "/usos",
      "permanent": true
    },
    {
      "source": "/skills",
      "destination": "/usos",
      "permanent": true
    },
    {
      "source": "/experience",
      "destination": "/#experiencia",
      "permanent": true
    },
    {
      "source": "/experiencia",
      "destination": "/#experiencia",
      "permanent": true
    },
    {
      "source": "/resume",
      "destination": "/Curriculo-LucasCavalheri.pdf",
      "permanent": true
    },
    {
      "source": "/cv",
      "destination": "/Curriculo-LucasCavalheri.pdf",
      "permanent": true
    },
    {
      "source": "/curriculo",
      "destination": "/Curriculo-LucasCavalheri.pdf",
      "permanent": true
    }
  ]
}
