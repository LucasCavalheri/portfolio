---
import PaginaTexto from "../components/PaginaTexto.astro";
import { paginas } from "../data/site";
---

<PaginaTexto
  titulo="404"
  tituloPagina="Página não encontrada — Lucas Cavalheri"
  descricao="Este endereço não existe neste site. Veja a lista de páginas disponíveis."
  resumo="Este endereço não existe. Abaixo está tudo o que existe."
>
  <h2>páginas do site</h2>
  <ul>
    {
      paginas.map((pagina) => (
        <li>
          <a class="link link-text" href={pagina.rota}>
            {pagina.rota}
          </a>{" "}
          — {pagina.resumo}
        </li>
      ))
    }
  </ul>

  <h2>arquivos para agentes</h2>
  <ul>
    <li>
      <a class="link link-text" href="/llms.txt">/llms.txt</a> — o que este site é e quando me chamar
    </li>
    <li>
      <a class="link link-text" href="/sitemap-index.xml">/sitemap-index.xml</a> — todas as URLs
    </li>
    <li>
      <a class="link link-text" href="/robots.txt">/robots.txt</a> — regras de rastreamento
    </li>
    <li>
      <a class="link link-text" href="/.well-known/api-catalog">/.well-known/api-catalog</a> — catálogo RFC 9727
    </li>
    <li>
      <a class="link link-text" href="/.well-known/mcp/server-card.json">/.well-known/mcp/server-card.json</a> — MCP
    </li>
    <li>
      <a class="link link-text" href="/auth.md">/auth.md</a> — autenticação (a API é pública)
    </li>
  </ul>
  <p>
    Qualquer página responde em markdown com <strong>Accept: text/markdown</strong> ou pelo sufixo
    <strong>.md</strong>.
  </p>
</PaginaTexto>
