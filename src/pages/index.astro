---
import Layout from "../layouts/Layout.astro";
import Tec from "../components/Tec.astro";
import {
  siAstro,
  siClaudecode,
  siCursor,
  siCloudflare,
  siDocker,
  siElectron,
  siGit,
  siGithub,
  siHotwire,
  siJavascript,
  siMongodb,
  siMysql,
  siNextdotjs,
  siNodedotjs,
  siHostinger,
  siPostgresql,
  siReact,
  siRedis,
  siRuby,
  siRubyonrails,
  siSass,
  siSqlite,
  siTailwindcss,
  siTypescript,
  siVercel,
  siVuedotjs,
} from "simple-icons";
import { awsIcon, openaiIcon, playwrightIcon } from "../data/icons";
import { rspecLogo, vitestLogo } from "../data/logos";

const tec = {
  ruby: { nome: "Ruby", icon: siRuby },
  rails: { nome: "Rails", icon: siRubyonrails },
  hotwire: { nome: "Hotwire", icon: siHotwire },
  rspec: { nome: "RSpec", logo: rspecLogo },
  vitest: { nome: "Vitest", logo: vitestLogo },
  playwright: { nome: "Playwright", icon: playwrightIcon },
  scss: { nome: "SCSS", icon: siSass },
  tailwind: { nome: "Tailwind", icon: siTailwindcss },
  javascript: { nome: "JavaScript", icon: siJavascript },
  typescript: { nome: "TypeScript", icon: siTypescript },
  node: { nome: "Node.js", icon: siNodedotjs },
  postgres: { nome: "PostgreSQL", icon: siPostgresql },
  mysql: { nome: "MySQL", icon: siMysql },
  sqlite: { nome: "SQLite", icon: siSqlite },
  redis: { nome: "Redis", icon: siRedis },
  mongo: { nome: "MongoDB", icon: siMongodb },
  react: { nome: "React", icon: siReact },
  next: { nome: "Next.js", icon: siNextdotjs },
  vue: { nome: "Vue", icon: siVuedotjs },
  astro: { nome: "Astro", icon: siAstro },
  electron: { nome: "Electron", icon: siElectron },
  aws: { nome: "AWS", icon: awsIcon },
  vercel: { nome: "Vercel", icon: siVercel },
  cloudflare: { nome: "Cloudflare", icon: siCloudflare },
  hostinger: { nome: "Hostinger", icon: siHostinger },
  git: { nome: "Git", icon: siGit },
  github: { nome: "GitHub", icon: siGithub },
  docker: { nome: "Docker", icon: siDocker },
  cursor: { nome: "Cursor", icon: siCursor },
  claude: { nome: "Claude Code", icon: siClaudecode },
  codex: { nome: "Codex", icon: openaiIcon },
};

const projetos = [
  {
    nome: "EduConnect",
    descricao:
      "Plataforma escolar completa: turmas, avaliações, presença e atividades com IA.",
    tec: [tec.ruby, tec.rails, tec.postgres, tec.scss],
    site: "",
    repo: "",
  },
  {
    nome: "Meigana",
    descricao: "Loja online completa, do catálogo ao checkout.",
    tec: [tec.ruby, tec.rails, tec.postgres, tec.tailwind],
    site: "",
    repo: "",
  },
  {
    nome: "My VPNs",
    descricao:
      "App Linux para gerenciar múltiplas conexões OpenFortiVPN, com bandeja e reconexão automática.",
    tec: [tec.typescript, tec.react, tec.electron],
    site: "",
    repo: "",
  },
];

const experiencias = [
  {
    cargo: "Desenvolvedor Web Full Stack Pleno, Tropical Hub",
    site: "tropicalhub.co",
    url: "https://tropicalhub.co",
    periodo: "2024 — hoje",
    tec: [tec.ruby, tec.rails, tec.hotwire, tec.postgres, tec.redis],
  },
  {
    cargo: "Desenvolvedor Web Full Stack Júnior, Grupo Polgo",
    site: "polgo.com.br",
    url: "https://www.polgo.com.br",
    periodo: "2023 — 2024",
    tec: [tec.ruby, tec.rails, tec.javascript, tec.react, tec.postgres],
  },
  {
    cargo: "Desenvolvedor Freelancer, projetos independentes",
    site: "github.com/LucasCavalheri",
    url: "https://github.com/LucasCavalheri",
    periodo: "2022 — hoje",
    tec: [tec.rails, tec.typescript, tec.react, tec.next, tec.astro],
  },
];

const stack = [
  { nome: "Linguagens", itens: [tec.ruby, tec.javascript, tec.typescript] },
  { nome: "Back-End", itens: [tec.rails, tec.node] },
  { nome: "Front-End", itens: [tec.react, tec.next, tec.vue, tec.scss, tec.tailwind] },
  { nome: "Testes", itens: [tec.rspec, tec.vitest, tec.playwright] },
  { nome: "Dados", itens: [tec.postgres, tec.mysql, tec.sqlite, tec.redis, tec.mongo] },
  { nome: "Cloud", itens: [tec.aws, tec.vercel, tec.cloudflare, tec.hostinger] },
  { nome: "Ferramentas", itens: [tec.git, tec.github, tec.docker] },
  { nome: "IA", itens: [tec.cursor, tec.codex, tec.claude] },
];

const contatos = [
  { rotulo: "GitHub", valor: "@LucasCavalheri", url: "https://github.com/LucasCavalheri" },
  { rotulo: "E-mail", valor: "lucas.dev.carvalho@gmail.com", url: "mailto:lucas.dev.carvalho@gmail.com" },
  { rotulo: "Currículo", valor: "PDF", url: "/Curriculo-LucasCavalheri.pdf" },
  { rotulo: "Local", valor: "Mogi Mirim, SP · remoto", url: "" },
];

const usuarioGithub = "LucasCavalheri";
const celulasEsqueleto = Array.from({ length: 371 }, (_, i) => i);

const anoAtual = new Date().getFullYear();
const atualizadoEm = new Date().toLocaleDateString("pt-BR", {
  day: "2-digit",
  month: "short",
  year: "numeric",
});
---

<Layout
  title="Lucas Cavalheri — Desenvolvedor Web Full Stack"
  description="Lucas Cavalheri é desenvolvedor web full stack. Cria produtos digitais com Ruby on Rails e código que dá gosto de manter."
>
  <header class="container topbar reveal-top">
    <nav id="nav" aria-label="Navegação principal">
      <a class="nav-link" href="#inicio">início</a>
      <a class="nav-link" href="#projetos">projetos</a>
      <a class="nav-link" href="#atividade">atividade</a>
      <a class="nav-link" href="#experiencia">experiência</a>
      <a class="nav-link" href="#contato">contato</a>
      <span class="nav-line" aria-hidden="true"></span>
    </nav>
    <button id="theme-toggle" type="button" aria-label="Alternar tema" aria-pressed="true">
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
      </svg>
    </button>
  </header>

  <main class="container">
    <section class="section intro" id="inicio">
      <div class="intro-head">
        <div class="avatar" id="avatar">
          <img
            src="https://github.com/LucasCavalheri.png?size=160"
            alt="Retrato de Lucas Cavalheri"
            width="60"
            height="60"
            loading="eager"
          />
          <span class="avatar-glow" aria-hidden="true"></span>
        </div>
        <div>
          <h1><span>Lucas</span> <span>Cavalheri</span></h1>
          <p class="intro-role">Desenvolvedor Web Full Stack Pleno</p>
        </div>
      </div>

      <div class="prose">
        <p>
          Construo aplicações web robustas e fáceis de manter, de APIs e integrações a painéis
          administrativos e deploy em produção.
        </p>
        <p>
          Sou Desenvolvedor Web Full Stack Pleno na <a class="link link-text link-brand" href="https://tropicalhub.co" target="_blank" rel="noopener"><img class="brand-icon" src="/tropical-hub.png" alt="" width="16" height="16" />Tropical Hub</a>, onde cuido de integrações, APIs e painéis administrativos, além dos code reviews e do fluxo de Git da squad.
        </p>
        <p>
          Meu dia a dia é <strong>Ruby</strong> e <strong>Rails</strong>, sempre pensando em quem vai
          manter o código amanhã.
        </p>
        <p>
          Quer trabalhar junto? Veja meu <a class="link link-text" href="/Curriculo-LucasCavalheri.pdf" download>currículo <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14"></path></svg></a>.
        </p>
      </div>

      <div class="intro-actions">
        <a class="button button-primary" href="mailto:lucas.dev.carvalho@gmail.com">
          <svg class="icon-stroke" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="5.5" width="18" height="13" rx="2"></rect>
            <path d="m3.5 7 8.5 6 8.5-6"></path>
          </svg>
          Enviar e-mail
        </a>
        <a class="button" href="https://github.com/LucasCavalheri" target="_blank" rel="noopener">
          <svg class="icon-fill" viewBox="0 0 24 24" aria-hidden="true">
            <path d={siGithub.path}></path>
          </svg>
          Ver GitHub
        </a>
      </div>
    </section>

    <section class="section" id="projetos">
      <div class="section-head" data-anim>
        <h2 class="section-title">projetos<span class="dot">.</span></h2>
        <a class="anchor" href="#projetos" aria-label="Link para projetos">#</a>
      </div>
      <div class="rows">
        {
          projetos.map((projeto, i) => (
            <div class="row" data-anim style={`--stagger: ${i * 0.07}s`}>
              <div class="row-top">
                <h3>{projeto.nome}</h3>
                <div class="row-links">
                  {projeto.site && (
                    <a class="link link-xs" href={projeto.site} target="_blank" rel="noopener">
                      <span>Site</span>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M17 7H9M17 7v8" /></svg>
                    </a>
                  )}
                  {projeto.repo && (
                    <a class="link link-xs" href={projeto.repo} target="_blank" rel="noopener">
                      <span>GitHub</span>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M17 7H9M17 7v8" /></svg>
                    </a>
                  )}
                </div>
              </div>
              <p class="row-text">{projeto.descricao}</p>
              <div class="tec-row">
                {projeto.tec.map((item) => <Tec item={item} />)}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section" id="atividade">
      <div class="section-head" data-anim>
        <h2 class="section-title">atividade<span class="dot">.</span></h2>
        <a class="anchor" href="#atividade" aria-label="Link para atividade">#</a>
      </div>
      <div class="activity" data-anim>
        <div class="activity-top">
          <p><strong id="contrib-total">—</strong> contribuições no último ano</p>
          <a
            class="link link-xs"
            href={`https://github.com/${usuarioGithub}`}
            target="_blank"
            rel="noopener"
          >
            <span id="contrib-status">GitHub</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M17 7H9M17 7v8" /></svg>
          </a>
        </div>
        <div class="activity-scroll">
          <div class="activity-months" id="contrib-months" aria-hidden="true"></div>
          <div
            class="activity-grid"
            id="contrib-grid"
            role="img"
            aria-label="Contribuições no GitHub no último ano"
          >
            {celulasEsqueleto.map(() => <span class="cell" data-level="0" />)}
          </div>
        </div>
        <div class="activity-legend">
          <span>menos</span>
          <i class="cell" data-level="0"></i>
          <i class="cell" data-level="1"></i>
          <i class="cell" data-level="2"></i>
          <i class="cell" data-level="3"></i>
          <i class="cell" data-level="4"></i>
          <span>mais</span>
        </div>
      </div>
      <div class="activity-tip" id="contrib-tip" role="tooltip" aria-hidden="true"></div>
    </section>

    <section class="section" id="experiencia">
      <div class="section-head" data-anim>
        <h2 class="section-title">experiência<span class="dot">.</span></h2>
        <a class="anchor" href="#experiencia" aria-label="Link para experiência">#</a>
      </div>
      <div class="rows">
        {
          experiencias.map((experiencia, i) => (
            <div class="row" data-anim style={`--stagger: ${i * 0.07}s`}>
              <div class="row-top">
                <div>
                  <h3>{experiencia.cargo}</h3>
                  <div class="row-at">
                    <span>em,</span>
                    <a class="link link-sm" href={experiencia.url} target="_blank" rel="noopener">
                      <span>{experiencia.site}</span>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M17 7H9M17 7v8" /></svg>
                    </a>
                  </div>
                </div>
                <p class="row-date">{experiencia.periodo}</p>
              </div>
              <div class="tec-row">
                {experiencia.tec.map((item) => <Tec item={item} />)}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section" id="stack">
      <div class="section-head" data-anim>
        <h2 class="section-title">stack<span class="dot">.</span></h2>
        <a class="anchor" href="#stack" aria-label="Link para stack">#</a>
      </div>
      <div class="rows">
        {
          stack.map((grupo, i) => (
            <div class="row row-inline" data-anim style={`--stagger: ${i * 0.05}s`}>
              <h3>{grupo.nome}</h3>
              <div class="tec-row tec-row-end">
                {grupo.itens.map((item) => <Tec item={item} label />)}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section" id="contato">
      <div class="section-head" data-anim>
        <h2 class="section-title">contato<span class="dot">.</span></h2>
        <a class="anchor" href="#contato" aria-label="Link para contato">#</a>
      </div>
      <div class="contact-grid">
        {
          contatos.map((contato, i) =>
            contato.url ? (
              <a
                class="link link-sm"
                data-anim
                style={`--stagger: ${i * 0.06}s`}
                href={contato.url}
                target={contato.url.startsWith("http") ? "_blank" : undefined}
                rel="noopener"
              >
                <span>{contato.valor}</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M17 7H9M17 7v8" /></svg>
              </a>
            ) : (
              <span class="contact-plain" data-anim style={`--stagger: ${i * 0.06}s`}>{contato.valor}</span>
            )
          )
        }
      </div>
    </section>
  </main>

  <footer class="container site-footer" data-anim>
    <div>
      <p>Atualizado · {atualizadoEm}</p>
      <p>© {anoAtual} <span>Lucas Cavalheri</span></p>
    </div>
  </footer>

  <button id="scroll-top" type="button" aria-label="Voltar ao topo" data-visible="false" data-direction="down">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6"></path></svg>
  </button>
</Layout>

<style>
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2.5rem;
  }

  .topbar nav {
    position: relative;
    display: flex;
    align-items: center;
    margin-left: -0.625rem;
  }

  /* Sublinhado que desliza entre os itens do menu */
  .nav-line {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1.5px;
    border-radius: 1px;
    background: var(--primary);
    opacity: 0;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), width 0.45s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s;
  }

  .nav-line[data-ready="true"] {
    opacity: 1;
  }

  .nav-link[data-active="true"] {
    color: var(--foreground);
  }

  .topbar nav a {
    padding: 0.25rem 0.625rem;
    border-radius: 0.375rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    transition: color 0.15s;
  }

  .topbar nav a:hover {
    color: var(--foreground);
  }

  #theme-toggle {
    display: inline-flex;
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    color: var(--muted-foreground);
    transition: background-color 0.15s, color 0.15s;
  }

  #theme-toggle:hover {
    background: var(--muted);
    color: var(--foreground);
  }

  #theme-toggle svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.6;
  }

  :root[data-theme="dark"] .icon-sun,
  :root[data-theme="light"] .icon-moon {
    display: none;
  }

  main {
    padding-block: 3.5rem;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem 0;
  }

  .section-head {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.25rem;
  }

  .dot {
    display: inline-block;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .section[data-active="true"] .dot {
    animation: dot-beat 2.4s ease-in-out infinite;
    color: var(--foreground);
  }

  @keyframes dot-beat {
    0%,
    100% {
      opacity: 0.35;
      transform: translateY(0) scale(1);
    }
    50% {
      opacity: 1;
      transform: translateY(-1px) scale(1.15);
    }
  }

  .anchor {
    display: inline-flex;
    width: 1.75rem;
    height: 1.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    opacity: 0;
    transition: background-color 0.15s, color 0.15s, opacity 0.15s;
  }

  .section-head:hover .anchor {
    opacity: 1;
  }

  .anchor:hover {
    background: var(--muted);
    color: var(--foreground);
  }

  /* Abertura: avatar e nome entram em sequência */
  .intro-head {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .avatar {
    position: relative;
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    animation: enter 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    border-radius: 9999px;
    isolation: isolate;
    perspective: 400px;
    transform-style: preserve-3d;
    transition: border-radius 0.4s ease, box-shadow 0.4s ease;
  }

  .avatar img {
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg)) scale(var(--tilt-scale, 1));
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Brilho especular que acompanha o ponteiro */
  .avatar-glow {
    position: absolute;
    z-index: 1;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      circle at var(--glow-x, 50%) var(--glow-y, 50%),
      color-mix(in oklab, var(--foreground) 45%, transparent),
      transparent 55%
    );
    opacity: 0;
    pointer-events: none;
    mix-blend-mode: soft-light;
    transition: opacity 0.35s ease;
  }

  .avatar[data-hover="true"] {
    border-radius: 38%;
    box-shadow: 0 0 0 1px var(--border);
  }

  .avatar[data-hover="true"] .avatar-glow {
    opacity: 1;
  }

  h1 {
    color: var(--primary);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.375;
    white-space: nowrap;
  }

  h1 span {
    display: inline-block;
    animation: enter 0.6s ease both;
  }

  h1 span:first-child {
    animation-delay: 0.15s;
  }

  h1 span:last-child {
    animation-delay: 0.25s;
  }

  .intro-role {
    margin-top: 0.25rem;
    animation: enter 0.6s ease both;
    animation-delay: 0.35s;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.375;
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    animation: enter 0.6s ease both;
    animation-delay: 0.45s;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.625rem;
  }

  .prose strong {
    color: var(--primary);
    font-weight: 500;
  }

  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    animation: enter 0.6s ease both;
    animation-delay: 0.55s;
  }

  .button {
    display: inline-flex;
    height: 2rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    padding-inline: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    color: var(--foreground);
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    transition: background-color 0.15s, border-color 0.15s, translate 0.1s;
  }

  .button:hover {
    background: var(--muted);
  }

  .button:active {
    translate: 0 1px;
  }

  .button svg {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
    margin-right: 0.375rem;
  }

  .button .icon-fill {
    fill: currentColor;
  }

  .button .icon-stroke {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .button-primary {
    border-color: transparent;
    background: var(--primary);
    color: var(--background);
  }

  .button-primary:hover {
    background: var(--foreground);
  }

  /* Reveal por scroll: sobe 10px, desfoca 6px, com stagger por item */
  :global([data-js]) [data-anim] {
    opacity: 0;
    transform: translateY(10px);
    filter: blur(6px);
  }

  :global([data-js]) [data-anim][data-in="true"] {
    opacity: 1;
    transform: none;
    filter: none;
    transition:
      opacity 0.5s ease var(--stagger, 0s),
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1) var(--stagger, 0s),
      filter 0.5s ease var(--stagger, 0s);
  }

  .row-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .row h3 {
    color: var(--primary);
    font-size: 1rem;
    font-weight: 400;
  }

  .row-links {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.375rem;
  }

  .row-text {
    margin-top: 0.25rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .tec-row {
    display: flex;
    margin-top: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.875rem;
  }

  .tec-row :global(.tec) {
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .tec-row-end {
    margin-top: 0;
    justify-content: flex-end;
  }

  /* Gráfico de contribuições */
  .activity {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .activity-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .activity-top strong {
    color: var(--primary);
    font-variant-numeric: tabular-nums;
    font-weight: 500;
  }

  .activity-scroll {
    overflow-x: auto;
    scrollbar-width: none;
  }

  .activity-scroll::-webkit-scrollbar {
    display: none;
  }

  .activity-grid {
    --cell: 9px;
    display: grid;
    width: max-content;
    grid-auto-columns: var(--cell);
    grid-auto-flow: column;
    grid-template-rows: repeat(7, var(--cell));
    gap: 2px;
  }

  /* As células do gráfico são criadas por JavaScript, então o estilo precisa
     ser global: seletor com escopo do Astro não alcança elemento criado em runtime. */
  :global(.cell) {
    border-radius: 2px;
    background: var(--cell-0);
    transition: transform 0.15s ease, background-color 0.3s ease;
  }

  :global(.cell[data-level="1"]) {
    background: var(--cell-1);
  }

  :global(.cell[data-level="2"]) {
    background: var(--cell-2);
  }

  :global(.cell[data-level="3"]) {
    background: var(--cell-3);
  }

  :global(.cell[data-level="4"]) {
    background: var(--cell-4);
  }

  .activity-grid[data-in="true"] :global(.cell) {
    animation: cell-in 0.4s ease both;
    animation-delay: var(--d, 0s);
  }

  /* A onda atravessa o gráfico da esquerda para a direita */
  @keyframes cell-in {
    from {
      opacity: 0;
      transform: scale(0.35);
    }
  }

  .activity-grid :global(.cell:hover) {
    transform: scale(1.45);
  }

  /* Faixa com as iniciais dos meses, alinhada às colunas do gráfico */
  .activity-months {
    display: grid;
    width: max-content;
    margin-bottom: 0.375rem;
    grid-auto-columns: 9px;
    grid-auto-flow: column;
    gap: 2px;
    color: var(--muted-foreground);
    font-size: 0.6875rem;
    line-height: 1;
  }

  .activity-months :global(span) {
    overflow: hidden;
    white-space: nowrap;
  }

  .activity-legend {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25rem;
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }

  .activity-legend :global(.cell) {
    width: 9px;
    height: 9px;
  }

  .activity-legend span:first-child {
    margin-right: 0.25rem;
  }

  .activity-legend span:last-child {
    margin-left: 0.25rem;
  }

  .activity-tip {
    position: fixed;
    z-index: 60;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: var(--card);
    color: var(--foreground);
    font-size: 0.75rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    translate: -50% calc(-100% - 8px);
    transition: opacity 0.15s;
  }

  .activity-tip[data-visible="true"] {
    opacity: 1;
  }

  .row-at {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .row-date {
    color: var(--muted-foreground);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .row-inline {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .row-inline .row-text {
    margin: 0;
    max-width: 70%;
    text-align: right;
  }

  .brand-icon {
    display: inline-block;
    width: 1rem;
    height: 1rem;
    margin-right: 0.375rem;
    margin-left: 0.125rem;
    border-radius: 9999px;
    vertical-align: -3px;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .link-brand:hover .brand-icon {
    transform: rotate(-8deg) scale(1.12);
  }

  .link-xs {
    font-size: 0.75rem;
  }

  .link-sm {
    font-size: 0.875rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    justify-items: start;
    gap: 0.5rem;
  }

  .contact-plain {
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .site-footer {
    margin-top: auto;
  }

  .site-footer > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.75rem;
    padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 0.75rem);
    border-top: 1px solid var(--border);
  }

  .site-footer p {
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }

  #scroll-top {
    position: fixed;
    z-index: 50;
    right: 1rem;
    bottom: calc(0.5rem + env(safe-area-inset-bottom, 0px));
    display: inline-flex;
    width: 1.75rem;
    height: 1.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    background: var(--muted);
    color: var(--foreground);
    transition: background-color 0.3s, opacity 0.3s;
  }

  #scroll-top svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.6;
  }

  #scroll-top[data-visible="false"] {
    opacity: 0;
    pointer-events: none;
  }

  #scroll-top[data-direction="down"] {
    opacity: 0.3;
  }

  #scroll-top[data-direction="down"]:hover,
  #scroll-top[data-direction="up"] {
    opacity: 1;
  }

  @media (min-width: 40rem) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }

    #scroll-top {
      bottom: 1rem;
    }
  }

  @media (min-width: 64rem) {
    #scroll-top {
      right: 2rem;
      bottom: 2rem;
    }
  }

  @media (max-width: 30rem) {
    h1 {
      white-space: normal;
    }

    .row-inline {
      flex-direction: column;
      gap: 0.25rem;
    }

    .row-inline .row-text {
      max-width: 100%;
      text-align: left;
    }

    .tec-row :global(.tec) {
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .tec-row-end {
      margin-top: 0.25rem;
      justify-content: flex-start;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const themeToggle = document.querySelector<HTMLButtonElement>("#theme-toggle");
  const scrollTop = document.querySelector<HTMLButtonElement>("#scroll-top");
  const themeMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  const applyTheme = (theme: "dark" | "light") => {
    root.dataset.theme = theme;
    if (themeMeta) themeMeta.content = theme === "dark" ? "#050505" : "#ffffff";
    themeToggle?.setAttribute("aria-pressed", String(theme === "dark"));
    try {
      localStorage.setItem("lucas-theme", theme);
    } catch {}
  };

  applyTheme(root.dataset.theme === "light" ? "light" : "dark");

  themeToggle?.addEventListener("click", (event) => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.style.setProperty("--theme-x", `${event.clientX}px`);
    root.style.setProperty("--theme-y", `${event.clientY}px`);

    const startTransition = (document as any).startViewTransition?.bind(document);
    if (!startTransition || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      applyTheme(next);
      return;
    }

    // A transição só executa o callback se a aba estiver compondo frames;
    // o timeout garante a troca de tema mesmo quando ela fica pendente.
    let applied = false;
    const apply = () => {
      if (applied) return;
      applied = true;
      applyTheme(next);
    };

    startTransition(apply);
    setTimeout(apply, 300);
  });

  let lastY = window.scrollY;

  const updateScrollButton = () => {
    if (!scrollTop) return;
    const y = window.scrollY;
    scrollTop.dataset.visible = String(y > 200);
    if (Math.abs(y - lastY) > 4) {
      scrollTop.dataset.direction = y > lastY ? "down" : "up";
      lastY = y;
    }
  };

  updateScrollButton();
  window.addEventListener("scroll", updateScrollButton, { passive: true });

  scrollTop?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });

  const semMovimento = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Reveal por scroll: cada bloco entra quando chega na tela
  const revelador = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        (entry.target as HTMLElement).dataset.in = "true";
        revelador.unobserve(entry.target);
      });
    },
    { rootMargin: "0px 0px -8% 0px", threshold: 0.15 }
  );

  const blocos = [...document.querySelectorAll<HTMLElement>("[data-anim]")];
  blocos.forEach((el) => revelador.observe(el));

  // Rede de segurança: se o observer não rodar (aba em segundo plano, navegador
  // sem suporte), o conteúdo aparece de qualquer forma.
  const revelarTudo = () => {
    blocos.forEach((el) => {
      el.dataset.in = "true";
    });
    revelador.disconnect();
  };

  setTimeout(revelarTudo, 1600);

  // Sublinhado do menu: segue o item ativo e acompanha o hover
  const nav = document.querySelector<HTMLElement>("#nav");
  const navLine = nav?.querySelector<HTMLElement>(".nav-line");
  const navLinks = [...(nav?.querySelectorAll<HTMLAnchorElement>(".nav-link") ?? [])];
  let linkAtivo = navLinks[0];

  const moverLinha = (alvo?: HTMLElement) => {
    if (!navLine || !alvo) return;
    navLine.style.width = `${alvo.offsetWidth}px`;
    navLine.style.transform = `translateX(${alvo.offsetLeft}px)`;
    navLine.dataset.ready = "true";
  };

  navLinks.forEach((link) => {
    link.addEventListener("pointerenter", () => moverLinha(link));
    link.addEventListener("focus", () => moverLinha(link));
  });

  nav?.addEventListener("pointerleave", () => moverLinha(linkAtivo));

  // Qual seção está em foco: marca o link e faz o ponto do título pulsar
  const secoes = [...document.querySelectorAll<HTMLElement>("main > section")];
  const espia = new IntersectionObserver(
    (entries) => {
      const visivel = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (!visivel) return;
      const id = visivel.target.id;
      secoes.forEach((secao) => {
        secao.dataset.active = String(secao.id === id);
      });
      const link = navLinks.find((item) => item.hash === `#${id}`);
      navLinks.forEach((item) => {
        item.dataset.active = String(item === link);
      });
      if (link) {
        linkAtivo = link;
        moverLinha(link);
      }
    },
    { rootMargin: "-25% 0px -55% 0px", threshold: [0.05, 0.3, 0.6] }
  );

  secoes.forEach((secao) => espia.observe(secao));

  linkAtivo.dataset.active = "true";
  moverLinha(linkAtivo);
  // A largura muda quando a fonte termina de carregar
  document.fonts?.ready.then(() => moverLinha(linkAtivo));
  window.addEventListener("resize", () => moverLinha(linkAtivo));

  // Leve magnetismo nos ícones: quem está perto do ponteiro cresce e se aproxima
  document.querySelectorAll<HTMLElement>(".tec-row").forEach((fila) => {
    const itens = [...fila.querySelectorAll<HTMLElement>(".tec")];
    let pendente = false;

    const soltar = () => {
      itens.forEach((item) => {
        item.style.transform = "";
      });
    };

    fila.addEventListener("pointermove", (event) => {
      if (semMovimento() || pendente) return;
      pendente = true;
      requestAnimationFrame(() => {
        pendente = false;
        itens.forEach((item) => {
          const box = item.getBoundingClientRect();
          const centro = box.left + box.width / 2;
          const distancia = event.clientX - centro;
          const alcance = 90;
          const forca = Math.max(0, 1 - Math.abs(distancia) / alcance);
          if (forca === 0) {
            item.style.transform = "";
            return;
          }
          item.style.transform = `translateX(${distancia * 0.06 * forca}px) scale(${1 + 0.1 * forca})`;
        });
      });
    });

    fila.addEventListener("pointerleave", soltar);
    fila.addEventListener("pointercancel", soltar);
  });

  // Foto: inclina de leve na direção do ponteiro, com brilho acompanhando
  const avatar = document.querySelector<HTMLElement>("#avatar");

  avatar?.addEventListener("pointermove", (event) => {
    if (semMovimento()) return;
    const box = avatar.getBoundingClientRect();
    const x = (event.clientX - box.left) / box.width - 0.5;
    const y = (event.clientY - box.top) / box.height - 0.5;
    avatar.dataset.hover = "true";
    avatar.style.setProperty("--tilt-y", `${x * 12}deg`);
    avatar.style.setProperty("--tilt-x", `${y * -12}deg`);
    avatar.style.setProperty("--tilt-scale", "1.04");
    avatar.style.setProperty("--glow-x", `${(x + 0.5) * 100}%`);
    avatar.style.setProperty("--glow-y", `${(y + 0.5) * 100}%`);
  });

  const soltarAvatar = () => {
    if (!avatar) return;
    delete avatar.dataset.hover;
    avatar.style.setProperty("--tilt-y", "0deg");
    avatar.style.setProperty("--tilt-x", "0deg");
    avatar.style.setProperty("--tilt-scale", "1");
  };

  avatar?.addEventListener("pointerleave", soltarAvatar);
  avatar?.addEventListener("pointercancel", soltarAvatar);

  // Contribuições do GitHub
  const grid = document.querySelector<HTMLDivElement>("#contrib-grid");
  const total = document.querySelector<HTMLElement>("#contrib-total");
  const status = document.querySelector<HTMLElement>("#contrib-status");
  const tip = document.querySelector<HTMLDivElement>("#contrib-tip");

  const meses = ["jan", "fev", "mar", "abr", "mai", "jun", "jul", "ago", "set", "out", "nov", "dez"];

  const formatarData = (iso: string) => {
    const [ano, mes, dia] = iso.split("-");
    return `${dia} ${meses[Number(mes) - 1]} ${ano}`;
  };

  const renderContribuicoes = (dias: { date: string; count: number; level: number }[]) => {
    if (!grid) return;
    const fragment = document.createDocumentFragment();
    // Preenche o começo para a primeira coluna alinhar com o dia da semana correto
    const offset = new Date(`${dias[0].date}T12:00:00`).getDay();
    for (let i = 0; i < offset; i += 1) {
      const vazio = document.createElement("span");
      vazio.className = "cell";
      vazio.dataset.level = "0";
      vazio.style.visibility = "hidden";
      fragment.appendChild(vazio);
    }
    dias.forEach((dia, indice) => {
      const cell = document.createElement("span");
      const coluna = Math.floor((indice + offset) / 7);
      const linha = (indice + offset) % 7;
      cell.className = "cell";
      cell.dataset.level = String(Math.min(4, Math.max(0, Number(dia.level) || 0)));
      cell.dataset.date = dia.date;
      cell.dataset.count = String(dia.count);
      cell.style.setProperty("--d", `${coluna * 9 + linha * 22}ms`);
      fragment.appendChild(cell);
    });
    grid.replaceChildren(fragment);
    const colunasTotais = Math.ceil((dias.length + offset) / 7);
    grid.parentElement?.scrollTo({ left: grid.scrollWidth });

    // Faixa de meses: um rótulo por vez que o mês virar
    const faixa = document.querySelector<HTMLElement>("#contrib-months");
    if (faixa) {
      const marcos: { coluna: number; mes: number }[] = [];
      dias.forEach((dia, indice) => {
        const mes = Number(dia.date.split("-")[1]);
        if (marcos[marcos.length - 1]?.mes === mes) return;
        marcos.push({ coluna: Math.floor((indice + offset) / 7), mes });
      });

      faixa.replaceChildren(
        ...marcos.map((marco, i) => {
          const largura = (marcos[i + 1]?.coluna ?? colunasTotais) - marco.coluna;
          const rotulo = document.createElement("span");
          rotulo.style.gridColumn = `${marco.coluna + 1} / span ${Math.max(1, largura)}`;
          rotulo.textContent = largura >= 2 ? meses[marco.mes - 1] : "";
          return rotulo;
        })
      );
    }

    const onda = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          grid.dataset.in = "true";
          onda.disconnect();
        });
      },
      { threshold: 0.2 }
    );
    onda.observe(grid);
    setTimeout(() => {
      grid.dataset.in = "true";
      onda.disconnect();
    }, 1600);
  };

  const posicionarTip = (cell: HTMLElement) => {
    if (!tip) return;
    const bounds = cell.getBoundingClientRect();
    tip.style.left = `${bounds.left + bounds.width / 2}px`;
    tip.style.top = `${bounds.top}px`;
  };

  grid?.addEventListener("pointerover", (event) => {
    const cell = (event.target as Element)?.closest<HTMLElement>(".cell");
    if (!cell?.dataset.date || !tip) return;
    const count = Number(cell.dataset.count) || 0;
    tip.textContent = `${formatarData(cell.dataset.date)} · ${count} ${count === 1 ? "contribuição" : "contribuições"}`;
    posicionarTip(cell);
    tip.dataset.visible = "true";
  });

  grid?.addEventListener("pointerleave", () => {
    if (tip) tip.dataset.visible = "false";
  });

  fetch("https://github-contributions-api.jogruber.de/v4/LucasCavalheri?y=last")
    .then((response) => {
      if (!response.ok) throw new Error("contribuições indisponíveis");
      return response.json();
    })
    .then((data) => {
      const dias = Array.isArray(data.contributions) ? data.contributions.slice(-371) : [];
      if (!dias.length) throw new Error("sem dados");
      const soma = dias.reduce((acc: number, dia: { count: number }) => acc + (Number(dia.count) || 0), 0);
      if (total) total.textContent = soma.toLocaleString("pt-BR");
      renderContribuicoes(dias);
    })
    .catch(() => {
      if (total) total.textContent = "—";
      if (status) status.textContent = "ver no GitHub";
    });
</script>
