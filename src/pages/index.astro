const contributionCells = Array.from({ length: 364 }, (_, index) => {
  const week = Math.floor(index / 7);
  const wave =
    (Math.sin(index * 0.27) + Math.sin(index * 0.071 + 1.8) + Math.cos((index % 7) * 1.5)) /
    3;
  const trend = week > 27 ? 0.16 : week > 14 ? 0.04 : -0.05;
  const score = wave + trend;

  return score > 0.52 ? 4 : score > 0.2 ? 3 : score > -0.12 ? 2 : score > -0.45 ? 1 : 0;
});
---

