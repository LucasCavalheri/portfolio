      { nome: "TanStack", icon: siTanstack },
      { nome: "shadcn/ui", icon: siShadcnui },
      { nome: "Zod", icon: siZod },
      { nome: "Zustand", icon: zustandIcon, custom: true, mark: "z" },
    ],
  },
  {
    area: "05",
    nome: "IA",
    itens: [
      { nome: "Cursor", icon: siCursor },
      { nome: "Codex", icon: codexIcon, custom: true },
      { nome: "Claude Code", icon: siClaudecode },
    ],
  },
