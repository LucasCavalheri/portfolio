---
import Layout from "../layouts/Layout.astro";
import Tec from "../components/Tec.astro";
import { siGithub } from "simple-icons";
import { tec } from "../data/tec";
import { contatos } from "../data/contato";
import { legivel, FUNDO_CLARO, FUNDO_ESCURO } from "../data/cor";

const projetos = [
  {
    nome: "EduConnect",
    tipo: "Produto próprio",
    ano: "2026",
    descricao:
      "Plataforma escolar completa: turmas, avaliações, presença e atividades com IA.",
    tec: [tec.ruby, tec.rails, tec.postgres, tec.scss],
    site: "",
    repo: "",
    codigoPrivado: true,
  },
  {
    nome: "Meigana",
    tipo: "Cliente",
    ano: "2024",
    descricao: "Loja online completa, do catálogo ao checkout.",
    tec: [tec.ruby, tec.rails, tec.postgres, tec.tailwind],
    site: "",
    repo: "",
    codigoPrivado: true,
  },
  {
    nome: "My VPNs",
    tipo: "Ferramenta pessoal",
    ano: "2026",
    descricao:
      "App Linux para gerenciar múltiplas conexões OpenFortiVPN, com bandeja e reconexão automática.",
    tec: [tec.typescript, tec.react, tec.electron],
    site: "",
    repo: "https://github.com/LucasCavalheri/my-vpns",
    codigoPrivado: false,
  },
];

const experiencias = [
  {
    cargo: "Desenvolvedor Web Full Stack Pleno, Tropical Hub",
    site: "tropicalhub.co",
    url: "https://tropicalhub.co",
    periodo: "2024 — hoje",
    evidencia:
      "Integrações com HubSpot e ERP, APIs e painéis internos. Conduzo os code reviews e o fluxo de Git da squad.",
    tec: [tec.javascript, tec.typescript, tec.react, tec.next, tec.node, tec.postgres],
  },
  {
    cargo: "Desenvolvedor Web Full Stack Júnior, Grupo Polgo",
    site: "polgo.com.br",
    url: "https://www.polgo.com.br",
    periodo: "2023 — 2024",
    evidencia: "Aplicações web e mobile, do levantamento de requisitos ao deploy em produção.",
    tec: [tec.javascript, tec.typescript, tec.react, tec.next, tec.vue, tec.node, tec.mongo],
  },
  {
    cargo: "Desenvolvedor Freelancer, projetos independentes",
    site: "github.com/LucasCavalheri",
    url: "https://github.com/LucasCavalheri",
    periodo: "2022 — hoje",
    evidencia: "Produtos sob medida para pessoas e negócios, do primeiro rascunho ao que fica no ar.",
    tec: [tec.ruby, tec.rails, tec.javascript, tec.typescript, tec.react, tec.next, tec.vue, tec.postgres],
  },
];

// Home fica com o essencial; /usos tem a lista completa.
const stack = [
  { nome: "Linguagens", itens: [tec.ruby, tec.javascript, tec.typescript] },
  { nome: "Back-end", itens: [tec.rails, tec.hotwire, tec.node] },
  { nome: "Front-end", itens: [tec.react, tec.vue, tec.next, tec.scss, tec.tailwind] },
  { nome: "IA", itens: [tec.cursor, tec.codex, tec.claude] },
];

// o botão de copiar usa o mesmo endereço da lista de contatos
const emailContato = contatos.find((c) => c.id === "email")!.valor;
const usuarioGithub = "LucasCavalheri";

const anoAtual = new Date().getFullYear();
const atualizadoEm = new Date().toLocaleDateString("pt-BR", {
  day: "2-digit",
  month: "short",
  year: "numeric",
});
---

<Layout
  title="Lucas Cavalheri — Desenvolvedor Web Full Stack Pleno"
  description="Lucas Cavalheri é desenvolvedor web full stack pleno. Cria produtos digitais com Ruby on Rails e código que dá gosto de manter."
>
  <main class="container">
    <section class="section intro" id="inicio">
      <div class="intro-head">
        <div class="avatar" id="avatar">
          <img
            src="https://github.com/LucasCavalheri.png?size=160"
            alt="Retrato de Lucas Cavalheri"
            width="60"
            height="60"
            loading="eager"
          />
          <span class="avatar-glow" aria-hidden="true"></span>
        </div>
        <div>
          <h1><span>Lucas</span> <span>Cavalheri</span></h1>
          <p class="intro-role">Desenvolvedor Web Full Stack Pleno</p>
        </div>
      </div>

      <div class="prose">
        <p>
          Construo aplicações web robustas e fáceis de manter, de APIs e integrações a painéis
          administrativos e deploy em produção.
        </p>
        <p>
          Sou Desenvolvedor Web Full Stack Pleno na <a class="link link-text link-brand" href="https://tropicalhub.co" target="_blank" rel="noopener"><img class="brand-icon" src="/tropical-hub.png" alt="" width="16" height="16" />Tropical Hub</a>, onde cuido de integrações, APIs e painéis administrativos, além dos code reviews e do fluxo de Git da squad.
        </p>
        <p>
          No trabalho meu dia a dia é <strong>TypeScript</strong> e <strong>React</strong>. Nos
          projetos próprios é <strong>Ruby</strong> e <strong>Rails</strong>, e é para onde estou
          levando minha carreira. Em qualquer uma das duas, penso em quem vai manter o código amanhã.
        </p>
        <p>
          Quer trabalhar junto? Veja meu <a class="link link-text" href="/Curriculo-LucasCavalheri.pdf" download>currículo <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 20h14"></path></svg></a>.
        </p>
      </div>

      <div class="intro-actions">
        <a class="button button-primary" href="mailto:lucas.dev.carvalho@gmail.com">
          <svg class="icon-stroke" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="5.5" width="18" height="13" rx="2"></rect>
            <path d="m3.5 7 8.5 6 8.5-6"></path>
          </svg>
          Enviar e-mail
        </a>
        <button class="button botao-copiar" id="copiar-email" type="button" data-email={emailContato} aria-live="polite">
          <span class="copiar-icones" aria-hidden="true">
            <svg class="icon-stroke copiar-papel" viewBox="0 0 24 24">
              <rect x="9" y="9" width="11" height="11" rx="2"></rect>
              <path d="M15 6.5V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h.5"></path>
            </svg>
            <svg class="icon-stroke copiar-certo" viewBox="0 0 24 24">
              <path d="m5 13 4.5 4.5L19 7"></path>
            </svg>
          </span>
          <span class="copiar-rotulo"><span data-rotulo>Copiar e-mail</span></span>
        </button>
        <a class="button" href="https://github.com/LucasCavalheri" target="_blank" rel="noopener">
          <svg class="icon-fill" viewBox="0 0 24 24" aria-hidden="true">
            <path d={siGithub.path}></path>
          </svg>
          Ver GitHub
        </a>
      </div>
    </section>

    <section class="section" id="projetos">
      <div class="section-head" data-anim>
        <h2 class="section-title">projetos<span class="dot">.</span></h2>
        <a class="anchor" href="#projetos" aria-label="Link para projetos">#</a>
      </div>
      <div class="rows">
        {
          projetos.map((projeto, i) => (
            <div class="row" data-anim style={`--stagger: ${i * 0.07}s`}>
              <p class="row-meta">
                {projeto.tipo} · {projeto.ano}
              </p>
              <div class="row-top">
                <h3>{projeto.nome}</h3>
                <div class="row-links">
                  {projeto.site && (
                    <a class="link link-xs" href={projeto.site} target="_blank" rel="noopener">
                      <span>Site</span>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M17 7H9M17 7v8" /></svg>
                    </a>
                  )}
                  {projeto.repo && (
                    <a class="link link-xs" href={projeto.repo} target="_blank" rel="noopener">
                      <span>GitHub</span>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M17 7H9M17 7v8" /></svg>
                    </a>
                  )}
                  {projeto.codigoPrivado && <span class="row-nota">código privado</span>}
                </div>
              </div>
              <p class="row-text">{projeto.descricao}</p>
              <div class="tec-row">
                {projeto.tec.map((item) => <Tec item={item} />)}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section" id="experiencia">
      <div class="section-head" data-anim>
        <h2 class="section-title">experiência<span class="dot">.</span></h2>
        <a class="anchor" href="#experiencia" aria-label="Link para experiência">#</a>
      </div>
      <div class="rows">
        {
          experiencias.map((experiencia, i) => (
            <div class="row" data-anim style={`--stagger: ${i * 0.07}s`}>
              <div class="row-top">
                <div>
                  <h3>{experiencia.cargo}</h3>
                  <div class="row-at">
                    <span>em,</span>
                    <a class="link link-sm" href={experiencia.url} target="_blank" rel="noopener">
                      <span>{experiencia.site}</span>
                      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M17 7H9M17 7v8" /></svg>
                    </a>
                  </div>
                </div>
                <p class="row-date">{experiencia.periodo}</p>
              </div>
              <p class="row-text">{experiencia.evidencia}</p>
              <div class="tec-row">
                {experiencia.tec.map((item) => <Tec item={item} />)}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section" id="atividade">
      <div class="section-head" data-anim>
        <h2 class="section-title">atividade<span class="dot">.</span></h2>
        <a class="anchor" href="#atividade" aria-label="Link para atividade">#</a>
      </div>
      <div class="activity" data-anim>
        <div class="activity-top">
          <p><strong id="contrib-total">—</strong> contribuições no último ano</p>
          <a
            class="link link-xs"
            href={`https://github.com/${usuarioGithub}`}
            target="_blank"
            rel="noopener"
          >
            <span id="contrib-status">GitHub</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M17 7H9M17 7v8" /></svg>
          </a>
        </div>
        <div class="activity-scroll">
          <div class="activity-track">
          <div class="activity-months" id="contrib-months" aria-hidden="true"></div>
          <div
            class="activity-grid"
            id="contrib-grid"
            role="img"
            aria-label="Contribuições no GitHub no último ano"
          >
          </div>
          </div>
        </div>
        <div class="activity-legend">
          <span>menos</span>
          <i class="cell" data-level="0"></i>
          <i class="cell" data-level="1"></i>
          <i class="cell" data-level="2"></i>
          <i class="cell" data-level="3"></i>
          <i class="cell" data-level="4"></i>
          <span>mais</span>
        </div>
      </div>
      <div class="activity-tip" id="contrib-tip" role="tooltip" aria-hidden="true"></div>
    </section>

    <section class="section" id="stack">
      <div class="section-head" data-anim>
        <h2 class="section-title">stack<span class="dot">.</span></h2>
        <a class="anchor" href="#stack" aria-label="Link para stack">#</a>
      </div>
      <div class="rows">
        {
          stack.map((grupo, i) => (
            <div class="row row-inline" data-anim style={`--stagger: ${i * 0.05}s`}>
              <h3>{grupo.nome}</h3>
              <div class="tec-row tec-row-end">
                {grupo.itens.map((item) => <Tec item={item} label />)}
              </div>
            </div>
          ))
        }
      </div>
      <a class="link link-xs usos-link" href="/usos" data-anim>
        <span>o resto da stack em /usos</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M17 7H9M17 7v8" /></svg>
      </a>
    </section>

    <section class="section" id="contato">
      <div class="section-head" data-anim>
        <h2 class="section-title">contato<span class="dot">.</span></h2>
        <a class="anchor" href="#contato" aria-label="Link para contato">#</a>
      </div>
      <div class="contact-grid">
        {
          contatos.map((contato, i) => {
            const cores = `--marca-escura: ${legivel(contato.hex, FUNDO_ESCURO)}; --marca-clara: ${legivel(contato.hex, FUNDO_CLARO)}`;
            const conteudo = (
              <>
                <svg
                  class:list={["contato-icone", contato.traco && "contato-icone-traco"]}
                  aria-hidden="true"
                >
                  <use href={`#c-${contato.id}`} />
                </svg>
                <span>{contato.valor}</span>
              </>
            );

            return contato.url ? (
              <a
                class="link link-sm contato"
                href={contato.url}
                target={contato.url.startsWith("http") ? "_blank" : undefined}
                rel="noopener"
                aria-label={`${contato.rotulo}: ${contato.valor}`}
                data-anim
                style={`--stagger: ${i * 0.05}s; ${cores}`}
              >
                {conteudo}
              </a>
            ) : (
              <span class="contato contato-plain" data-anim style={`--stagger: ${i * 0.05}s`}>
                {conteudo}
              </span>
            );
          })
        }
      </div>
    </section>
  </main>

</Layout>

<style>
  /* Abertura: avatar e nome entram em sequência */
  .intro-head {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .avatar {
    position: relative;
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    animation: enter 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    border-radius: 9999px;
    isolation: isolate;
    perspective: 400px;
    transform-style: preserve-3d;
    /* o contorno segue a forma, então anima junto com a imagem */
    transition: border-radius 0.55s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.55s ease;
  }

  /* border-radius herdado não anima: a imagem e o brilho precisam do
     valor próprio para o círculo virar squircle com suavidade */
  .avatar img,
  .avatar-glow {
    border-radius: 9999px;
    transition: border-radius 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg)) scale(var(--tilt-scale, 1));
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      border-radius 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .avatar[data-hover="true"] img,
  .avatar[data-hover="true"] .avatar-glow {
    border-radius: 34%;
  }

  /* Brilho especular que acompanha o ponteiro */
  .avatar-glow {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: radial-gradient(
      circle at var(--glow-x, 50%) var(--glow-y, 50%),
      color-mix(in oklab, var(--foreground) 45%, transparent),
      transparent 55%
    );
    opacity: 0;
    pointer-events: none;
    mix-blend-mode: soft-light;
    transition: opacity 0.35s ease;
  }

  .avatar[data-hover="true"] {
    border-radius: 34%;
    box-shadow: 0 0 0 1px var(--border);
  }

  .avatar[data-hover="true"] .avatar-glow {
    opacity: 1;
  }

  h1 {
    color: var(--primary);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.375;
    white-space: nowrap;
  }

  h1 span {
    display: inline-block;
    animation: enter 0.6s ease both;
  }

  h1 span:first-child {
    animation-delay: 0.15s;
  }

  h1 span:last-child {
    animation-delay: 0.25s;
  }

  .intro-role {
    margin-top: 0.25rem;
    animation: enter 0.6s ease both;
    animation-delay: 0.35s;
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.375;
  }

  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    animation: enter 0.6s ease both;
    animation-delay: 0.55s;
  }

  /* Gráfico de contribuições */
  .activity {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .activity-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .activity-top strong {
    color: var(--primary);
    font-variant-numeric: tabular-nums;
    font-weight: 500;
  }

  .activity-scroll {
    overflow-x: auto;
    scrollbar-width: none;
  }

  .activity-scroll::-webkit-scrollbar {
    display: none;
  }

  /* Um brilho atravessa a grade de vez em quando, de leve */
  .activity-track {
    position: relative;
    width: max-content;
  }

  .activity-track::after {
    position: absolute;
    top: 0;
    left: 0;
    width: 38%;
    height: 100%;
    background: linear-gradient(100deg, transparent, var(--brilho), transparent);
    content: "";
    opacity: 0;
    pointer-events: none;
  }

  /* Começa só depois que a grade entrou na tela e a onda diagonal passou */
  .activity-track:has(.activity-grid[data-in="true"])::after {
    animation: passar-luz 9s cubic-bezier(0.45, 0, 0.3, 1) 1.2s infinite;
  }

  @keyframes passar-luz {
    0%,
    6% {
      opacity: 0;
      transform: translateX(-110%);
    }
    18% {
      opacity: 1;
    }
    44%,
    100% {
      opacity: 0;
      transform: translateX(300%);
    }
  }

  .activity-grid {
    /* 7 linhas de 9px + 6 vãos de 2px: reserva a altura antes das células */
    min-height: 75px;
    --cell: 9px;
    display: grid;
    width: max-content;
    grid-auto-columns: var(--cell);
    grid-auto-flow: column;
    grid-template-rows: repeat(7, var(--cell));
    gap: 2px;
  }

  /* As células do gráfico são criadas por JavaScript, então o estilo precisa
     ser global: seletor com escopo do Astro não alcança elemento criado em runtime. */
  :global(.cell) {
    border-radius: 2px;
    background: var(--cell-0);
    transition: transform 0.15s ease, background-color 0.3s ease;
  }

  :global(.cell[data-level="1"]) {
    background: var(--cell-1);
  }

  :global(.cell[data-level="2"]) {
    background: var(--cell-2);
  }

  :global(.cell[data-level="3"]) {
    background: var(--cell-3);
  }

  :global(.cell[data-level="4"]) {
    background: var(--cell-4);
  }

  .activity-grid[data-in="true"] :global(.cell) {
    animation: cell-in 0.4s ease both;
    animation-delay: var(--d, 0s);
  }

  /* A onda atravessa o gráfico da esquerda para a direita */
  @keyframes cell-in {
    from {
      opacity: 0;
      transform: scale(0.35);
    }
  }

  .activity-grid :global(.cell:hover) {
    transform: scale(1.45);
  }

  /* Faixa com as iniciais dos meses, alinhada às colunas do gráfico */
  .activity-months {
    display: grid;
    width: max-content;
    margin-bottom: 0.375rem;
    grid-auto-columns: 9px;
    grid-auto-flow: column;
    gap: 2px;
    color: var(--muted-foreground);
    font-size: 0.6875rem;
    line-height: 1;
  }

  .activity-months :global(span) {
    overflow: hidden;
    white-space: nowrap;
  }

  .activity-legend {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25rem;
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }

  .activity-legend :global(.cell) {
    width: 9px;
    height: 9px;
  }

  .activity-legend span:first-child {
    margin-right: 0.25rem;
  }

  .activity-legend span:last-child {
    margin-left: 0.25rem;
  }

  .activity-tip {
    position: fixed;
    z-index: 60;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: var(--card);
    color: var(--foreground);
    font-size: 0.75rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    translate: -50% calc(-100% - 8px);
    transition: opacity 0.15s;
  }

  .activity-tip[data-visible="true"] {
    opacity: 1;
  }

  .usos-link {
    align-self: flex-start;
  }

  .brand-icon {
    display: inline-block;
    width: 1rem;
    height: 1rem;
    margin-right: 0.375rem;
    margin-left: 0.125rem;
    border-radius: 9999px;
    vertical-align: -3px;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .link-brand:hover .brand-icon {
    transform: rotate(-8deg) scale(1.12);
  }

  main {
    padding-block: 3.5rem;
  }

  @media (max-width: 30rem) {
    h1 {
      white-space: normal;
    }
  }

  /* Botão de copiar: o clipboard vira certo e o rótulo troca subindo */
  .botao-copiar {
    position: relative;
  }

  .copiar-icones {
    position: relative;
    display: inline-flex;
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
    margin-right: 0.375rem;
  }

  .copiar-icones svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    transition: opacity 0.28s ease, transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .copiar-certo {
    opacity: 0;
    transform: scale(0.5) rotate(-12deg);
  }

  .botao-copiar[data-copiado="true"] .copiar-papel {
    opacity: 0;
    transform: scale(0.6) rotate(10deg);
  }

  .botao-copiar[data-copiado="true"] .copiar-certo {
    opacity: 1;
    transform: none;
  }

  .copiar-rotulo {
    display: inline-flex;
    overflow: hidden;
  }

  .copiar-rotulo span {
    animation: rotulo-entra 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes rotulo-entra {
    from {
      opacity: 0;
      transform: translateY(0.6em);
    }
  }

