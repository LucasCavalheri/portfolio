    descricao:
      "Produtos digitais com JavaScript, TypeScript, Ruby on Rails, React e Next.js para pessoas e negócios que querem sair do lugar.",
  },
];

const projetos = [
  {
    numero: "01",
    tipo: "loja online · 2024",
    nome: "Meigana",
    descricao:
      "Uma loja completa, do catálogo ao checkout. A experiência foi pensada para deixar a compra leve e a operação fácil de administrar.",
    tecnologias: ["Ruby on Rails", "Hotwire", "Tailwind"],
    classe: "project-primary",
  },
