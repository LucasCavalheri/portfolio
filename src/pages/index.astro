<script>
  const root = document.documentElement;
  const themeToggle = document.querySelector("#theme-toggle");
  const contributionGrid = document.querySelector("#contribution-grid");
  const contributionTooltip = document.querySelector("#contribution-tooltip");
  const contributionTotal = document.querySelector("#commit-total");
  const githubStatus = document.querySelector("#github-status");
  const profileCard = document.querySelector(".profile-card");
  const avatarWrap = document.querySelector(".avatar-wrap");
  const themeMeta = document.querySelector('meta[name="theme-color"]');
  const stackList = document.querySelector("#stack-list");
  const stackListToggle = document.querySelector("#stack-list-toggle");
  const stackGridToggle = document.querySelector("#stack-grid-toggle");
  let audioContext;

  const playWaterDrop = () => {
    try {
      const AudioContext = window.AudioContext || window.webkitAudioContext;
      if (!AudioContext) return;
      audioContext ||= new AudioContext();
      if (audioContext.state === "suspended") audioContext.resume();

      const now = audioContext.currentTime;
      const body = audioContext.createOscillator();
      const shimmer = audioContext.createOscillator();
      const bodyGain = audioContext.createGain();
      const shimmerGain = audioContext.createGain();

      body.type = "sine";
      body.frequency.setValueAtTime(1120, now);
      body.frequency.exponentialRampToValueAtTime(280, now + 0.34);
      bodyGain.gain.setValueAtTime(0.0001, now);
      bodyGain.gain.exponentialRampToValueAtTime(0.12, now + 0.008);
      bodyGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.42);

      shimmer.type = "triangle";
      shimmer.frequency.setValueAtTime(2200, now);
      shimmer.frequency.exponentialRampToValueAtTime(620, now + 0.22);
      shimmerGain.gain.setValueAtTime(0.0001, now);
      shimmerGain.gain.exponentialRampToValueAtTime(0.025, now + 0.006);
      shimmerGain.gain.exponentialRampToValueAtTime(0.0001, now + 0.2);

      body.connect(bodyGain).connect(audioContext.destination);
      shimmer.connect(shimmerGain).connect(audioContext.destination);
      body.start(now);
      shimmer.start(now);
      body.stop(now + 0.45);
      shimmer.stop(now + 0.24);
    } catch {}
  };

  const updateThemeButton = () => {
    const isDark = root.dataset.theme === "dark";
    themeToggle?.setAttribute("aria-pressed", String(isDark));
    themeToggle?.setAttribute("aria-label", isDark ? "Ativar tema claro" : "Ativar tema escuro");
  };

  updateThemeButton();

  const setStackView = (grid) => {
    stackList?.classList.toggle("stack-grid-view", grid);
    stackListToggle?.classList.toggle("active", !grid);
    stackGridToggle?.classList.toggle("active", grid);
    stackListToggle?.setAttribute("aria-pressed", String(!grid));
    stackGridToggle?.setAttribute("aria-pressed", String(grid));
  };

  stackListToggle?.addEventListener("click", () => setStackView(false));
  stackGridToggle?.addEventListener("click", () => setStackView(true));

  themeToggle?.addEventListener("click", (event) => {
    const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
    const pointerEvent = event instanceof MouseEvent ? event : null;
    const x = pointerEvent?.clientX ?? window.innerWidth - 44;
    const y = pointerEvent?.clientY ?? 30;
    playWaterDrop();
    root.style.setProperty("--theme-x", `${x}px`);
    root.style.setProperty("--theme-y", `${y}px`);

    const applyTheme = () => {
      if (nextTheme === "dark") root.dataset.theme = "dark";
      else delete root.dataset.theme;
      themeMeta?.setAttribute("content", nextTheme === "dark" ? "#111111" : "#f5f5f2");
      try {
        localStorage.setItem("lucas-theme", nextTheme);
      } catch {}
      updateThemeButton();
    };

    if (typeof document.startViewTransition === "function") document.startViewTransition(applyTheme);
    else applyTheme();
  });

  window.addEventListener("pointermove", (event) => {
    root.style.setProperty("--pointer-x", `${event.clientX}px`);
    root.style.setProperty("--pointer-y", `${event.clientY}px`);
  }, { passive: true });

  profileCard?.addEventListener("pointermove", (event) => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const bounds = profileCard.getBoundingClientRect();
    const x = (event.clientX - bounds.left) / bounds.width - 0.5;
    const y = (event.clientY - bounds.top) / bounds.height - 0.5;
    profileCard.style.setProperty("--card-rotate-x", `${y * -3.5}deg`);
    profileCard.style.setProperty("--card-rotate-y", `${x * 3.5}deg`);
    avatarWrap?.style.setProperty("--avatar-x", `${x * 10}px`);
    avatarWrap?.style.setProperty("--avatar-y", `${y * 10}px`);
  });

  profileCard?.addEventListener("pointerleave", () => {
    profileCard.style.setProperty("--card-rotate-x", "0deg");
    profileCard.style.setProperty("--card-rotate-y", "0deg");
    avatarWrap?.style.setProperty("--avatar-x", "0px");
    avatarWrap?.style.setProperty("--avatar-y", "0px");
  });

  const formatContributionDate = (date) => {
    const [year, month, day] = date.split("-");
    const months = ["jan.", "fev.", "mar.", "abr.", "mai.", "jun.", "jul.", "ago.", "set.", "out.", "nov.", "dez."];
    const monthIndex = Number(month) - 1;
    if (!year || !day || !months[monthIndex]) return date;
    return `${Number(day)} ${months[monthIndex]} ${year}`;
  };

  const renderContributions = (items) => {
    if (!contributionGrid || !items?.length) return;
    contributionGrid.innerHTML = "";
    items.slice(-364).forEach((item) => {
      const cell = document.createElement("span");
      const level = Math.min(4, Math.max(0, Number(item.level) || 0));
      cell.className = `contribution level-${level}`;
      const readableDate = formatContributionDate(item.date);
      const label = `${readableDate}: ${item.count} commit${item.count === 1 ? "" : "s"}`;
      cell.dataset.date = readableDate;
      cell.dataset.count = String(item.count);
      cell.setAttribute("aria-label", label);
      contributionGrid.appendChild(cell);
    });
  };

  const moveContributionTooltip = (cell) => {
    if (!contributionTooltip) return;
    const bounds = cell.getBoundingClientRect();
    contributionTooltip.style.left = `${bounds.left + bounds.width / 2}px`;
    contributionTooltip.style.top = `${bounds.top}px`;
  };

  contributionGrid?.addEventListener("pointerover", (event) => {
    const cell = event.target instanceof Element ? event.target.closest(".contribution-grid .contribution") : null;
    if (!cell || !contributionTooltip || !cell.dataset.date) return;
    const count = Number(cell.dataset.count) || 0;
    contributionTooltip.textContent = `${cell.dataset.date} · ${count} commit${count === 1 ? "" : "s"}`;
    moveContributionTooltip(cell);
    contributionTooltip.dataset.visible = "true";
    contributionTooltip.setAttribute("aria-hidden", "false");
  });

  contributionGrid?.addEventListener("pointermove", (event) => {
    const cell = event.target instanceof Element ? event.target.closest(".contribution-grid .contribution") : null;
    if (cell) moveContributionTooltip(cell);
  });

  contributionGrid?.addEventListener("pointerout", (event) => {
    const cell = event.target instanceof Element ? event.target.closest(".contribution-grid .contribution") : null;
    const nextTarget = event.relatedTarget;
    if (!cell || (nextTarget instanceof Node && cell.contains(nextTarget))) return;
    if (contributionTooltip) {
      contributionTooltip.dataset.visible = "false";
      contributionTooltip.setAttribute("aria-hidden", "true");
    }
  });

  fetch("https://github-contributions-api.jogruber.de/v4/LucasCavalheri?y=last")
    .then((response) => {
      if (!response.ok) throw new Error("GitHub contributions unavailable");
      return response.json();
    })
    .then((data) => {
      const items = Array.isArray(data.contributions) ? data.contributions : [];
      const total = items.reduce((sum, item) => sum + (Number(item.count) || 0), 0);
      if (contributionTotal) contributionTotal.textContent = total.toLocaleString("pt-BR");
      if (githubStatus) githubStatus.textContent = "sincronizado agora";
      renderContributions(items);
    })
    .catch(() => {
      if (contributionTotal) contributionTotal.textContent = "atividade";
      if (githubStatus) githubStatus.textContent = "snapshot local";
    });
</script>

