import {
  siAstro,
  siClaudecode,
  siCursor,
  siDrizzle,
  siExpress,
  siFastapi,
  siFlask,
  siJavascript,
  siLaravel,
  siMongodb,
  siMysql,
  siNextdotjs,
  siNodedotjs,
