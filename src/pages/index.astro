    classe: "project-dark",
  },
];

const codexIcon = { path: "M8 7 4 12l4 5M16 7l4 5-4 5M13 5l-2 14" };
const zustandIcon = { path: "M7 6.5c0-1.7 1.5-3 3.3-3 .6 0 1.2.2 1.7.5.5-.6 1.3-1 2.2-1 1.8 0 3.3 1.3 3.3 3 0 .6-.2 1.2-.6 1.7 1.3.5 2.2 1.6 2.2 3.1 0 1.8-1.5 3.2-3.4 3.2-.4 0-.8-.1-1.2-.2.1.5.2 1 .2 1.5 0 2.1-1 4-2.4 5.7-1.4-1.7-2.4-3.6-2.4-5.7 0-.5.1-1 .2-1.5-.4.1-.8.2-1.2.2-1.9 0-3.4-1.4-3.4-3.2 0-1.5.9-2.6 2.2-3.1-.4-.5-.6-1.1-.6-1.7Z" };

const stack = [
  {
    area: "01",
    nome: "Linguagens",
    itens: [
      { nome: "Ruby", icon: siRuby },
      { nome: "JavaScript", icon: siJavascript },
      { nome: "TypeScript", icon: siTypescript },
      { nome: "PHP", icon: siPhp },
      { nome: "Python", icon: siPython },
    ],
  },
  {
    area: "02",
    nome: "Servidor",
    itens: [
      { nome: "Rails", icon: siRubyonrails },
      { nome: "Node.js", icon: siNodedotjs },
      { nome: "Express.js", icon: siExpress },
      { nome: "FastAPI", icon: siFastapi },
      { nome: "Flask", icon: siFlask },
      { nome: "Laravel", icon: siLaravel },
    ],
  },
  {
    area: "03",
    nome: "Banco de dados",
    itens: [
      { nome: "Prisma", icon: siPrisma },
      { nome: "Drizzle", icon: siDrizzle },
      { nome: "TypeORM", icon: siTypeorm },
      { nome: "PostgreSQL", icon: siPostgresql },
