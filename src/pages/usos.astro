---
import Layout from "../layouts/Layout.astro";
import Tec from "../components/Tec.astro";
import { tec } from "../data/tec";

const grupos = [
  {
    nome: "Linguagens",
    nota: "TypeScript em tudo que é novo. JavaScript onde o projeto ainda não tem tipos.",
    itens: [tec.javascript, tec.typescript],
  },
  {
    nome: "Front-end",
    nota: "React com Next.js é o padrão. Astro quando a página é conteúdo e precisa ser rápida.",
    itens: [tec.react, tec.next, tec.vue, tec.astro, tec.shadcn, tec.tailwind],
  },
  {
    nome: "Back-end",
    nota: "Fastify para API enxuta, NestJS quando o time precisa de estrutura clara desde o começo.",
    itens: [tec.node, tec.express, tec.fastify, tec.nest],
  },
  {
    nome: "ORMs",
    nota: "Drizzle pelo SQL explícito e pela tipagem. Prisma quando o projeto já vem com ele.",
    itens: [tec.drizzle, tec.prisma],
  },
  {
    nome: "Dados",
    nota: "PostgreSQL como escolha padrão. SQLite em ferramenta local, MongoDB quando o dado é documento.",
    itens: [tec.postgres, tec.mysql, tec.sqlite, tec.mongo],
  },
  {
    nome: "Cloud",
    nota: "Vercel para front-end, Render e Railway para serviço com banco, AWS quando a conta é do cliente.",
    itens: [tec.aws, tec.vercel, tec.render, tec.railway, tec.cloudflare, tec.hostinger],
  },
  {
    nome: "Ferramentas",
    nota: "Docker para subir o ambiente igual em qualquer máquina, Insomnia para testar as rotas na mão.",
    itens: [tec.git, tec.github, tec.docker, tec.vscode, tec.insomnia, tec.npm],
  },
  {
    nome: "IA",
    nota: "Agentes de código no dia a dia, sempre com revisão minha antes do commit.",
    itens: [tec.grok, tec.codex, tec.claude, tec.cursor],
  },
  {
    nome: "Sistema",
    nota: "Linux no desktop e no servidor, o que aproxima o ambiente de desenvolvimento da produção.",
    itens: [tec.ubuntu, tec.fedora],
  },
  {
    nome: "Trabalho",
    nota: "Onde a squad conversa e onde acontecem as dailies e os alinhamentos.",
    itens: [tec.slack, tec.meet],
  },
];
---

<Layout
  title="Usos — Lucas Cavalheri"
  description="Linguagens, frameworks e ferramentas que Lucas Cavalheri, desenvolvedor web full stack pleno, usa no dia a dia."
  tecnologias={grupos.flatMap((g) => g.itens)}
>
  <main class="container pagina-usos">
    <section class="section">
      <div class="section-head" data-anim>
        <h1 class="section-title">usos<span class="dot">.</span></h1>
      </div>
      <p class="pagina-resumo" data-anim>
        Tudo que passa pelo meu dia a dia, e não só o que está em destaque na home.
      </p>
      <div class="rows">
        {
          grupos.map((grupo, i) => (
            <div class="row" data-anim style={`--stagger: ${i * 0.05}s`}>
              <div class="grupo-topo">
                <h2>{grupo.nome}</h2>
                <div class="tec-row tec-row-end">
                  {grupo.itens.map((item) => (
                    <Tec item={item} label />
                  ))}
                </div>
              </div>
              <p class="grupo-nota">{grupo.nota}</p>
            </div>
          ))
        }
      </div>
      <a class="link link-sm" href="/#stack" data-anim>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 7 7 17M7 17h8M7 17V9" /></svg>
        <span>voltar para a home</span>
      </a>
    </section>
  </main>
</Layout>

<style is:global>
  .pagina-usos {
    padding-block: 3.5rem;
  }

  .pagina-resumo {
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.625rem;
  }

  /* Nas linhas, o nome da categoria tem o mesmo peso do h3 da home */
  .grupo-topo h2 {
    color: var(--primary);
    font-size: 1rem;
    font-weight: 400;
  }

  .grupo-topo {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .grupo-nota {
    margin-top: 0.375rem;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  @media (max-width: 30rem) {
    .grupo-topo {
      flex-direction: column;
      gap: 0.25rem;
    }
  }

  .link-sm {
    align-self: flex-start;
  }
</style>
