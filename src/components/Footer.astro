---
import { paginas } from "../data/site";

const anoAtual = new Date().getFullYear();
const atualizadoEm = new Date().toLocaleDateString("pt-BR", {
  day: "2-digit",
  month: "short",
  year: "numeric",
});

const rotaAtual = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<footer class="container site-footer" data-anim>
  <nav class="rodape-links" aria-label="Páginas do site">
    {
      paginas
        .filter((pagina) => pagina.rota !== rotaAtual)
        .map((pagina) => (
          <a class="link link-xs" href={pagina.rota}>
            <span>{pagina.titulo.toLowerCase()}</span>
          </a>
        ))
    }
    <a class="link link-xs" href="/llms.txt"><span>llms.txt</span></a>
    <a class="link link-xs" href="/openapi.json"><span>openapi</span></a>
    <a class="link link-xs" href="/api/v1/index.json"><span>api</span></a>
  </nav>
  <p class="rodape-agentes">
    Assistente de IA lendo esta página? O resumo completo está em
    <a class="link link-text" href="/llms.txt">/llms.txt</a>, e as cores, fontes e tokens da minha
    identidade visual, para gerar proposta ou PDF, em
    <a class="link link-text" href="/identidade.md">/identidade.md</a>.
  </p>
  <div>
    <p>Atualizado · {atualizadoEm}</p>
    <p>© {anoAtual} <span>Lucas Cavalheri</span></p>
  </div>
</footer>

<style is:global>
  .site-footer {
    margin-top: auto;
  }

  .rodape-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    padding-bottom: 0.625rem;
  }

  /* 24px de altura: o alvo mínimo de toque, sem encostar na linha de baixo */
  .rodape-links .link {
    min-height: 1.5rem;
    background-position: 0 calc(100% - 0.25rem);
  }

  .rodape-agentes {
    padding-bottom: 0.75rem;
    line-height: 1.5;
  }

  .site-footer > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.75rem;
    padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 0.75rem);
    border-top: 1px solid var(--border);
  }

  .site-footer p {
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }
</style>
