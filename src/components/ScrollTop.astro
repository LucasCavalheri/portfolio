<button id="scroll-top" type="button" aria-label="Voltar ao topo" data-visible="false">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6"></path></svg>
</button>

<style>
  /* Escondido por padrão: qualquer estado de destaque precisa vir depois,
     senão empata na especificidade e o botão aparece antes do primeiro scroll. */
  #scroll-top {
    position: fixed;
    z-index: 50;
    right: 1rem;
    bottom: calc(0.5rem + env(safe-area-inset-bottom, 0px));
    display: inline-flex;
    width: 1.75rem;
    height: 1.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    background: var(--muted);
    color: var(--foreground);
    opacity: 0;
    pointer-events: none;
    transition: background-color 0.3s, opacity 0.3s;
  }

  #scroll-top svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.6;
  }

  #scroll-top[data-visible="true"] {
    opacity: 1;
    pointer-events: auto;
  }

  /* Discreto só enquanto a leitura desce; ao parar volta a ficar nítido */
  #scroll-top[data-visible="true"][data-dim="true"] {
    opacity: 0.3;
  }

  #scroll-top[data-visible="true"]:hover,
  #scroll-top[data-visible="true"]:focus-visible {
    opacity: 1;
  }

  @media (min-width: 40rem) {
    #scroll-top {
      bottom: 1rem;
    }
  }

  @media (min-width: 64rem) {
    #scroll-top {
      right: 2rem;
      bottom: 2rem;
    }
  }
</style>
