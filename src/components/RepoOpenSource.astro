---
import Tec from "./Tec.astro";
import type { contribuicoes } from "../data/conteudo";
import { nomeTransicao } from "../data/transicao";

interface Props {
  grupo: (typeof contribuicoes)[number];
  [atributo: string]: unknown;
}

const { grupo, ...resto } = Astro.props;
const [dono, nome] = grupo.repo.split("/");

// "mai 2026": meio-dia evita que o fuso volte a data um dia
const mesAno = (data: string) =>
  new Date(`${data}T12:00:00`)
    .toLocaleDateString("pt-BR", { month: "short", year: "numeric" })
    .replace(".", "")
    .replace(" de ", " ");
---

<div class="row os-grupo" {...resto}>
  <div class="row-top">
    <div class="os-repo">
      <Tec item={grupo.tec} />
      <h3 style={`view-transition-name: ${nomeTransicao(grupo.repo)}`}>
        <a class="link os-repo-nome" href={`https://github.com/${grupo.repo}`} target="_blank" rel="noopener">
          <span class="os-dono">{dono}/</span><span>{nome}</span>
        </a>
      </h3>
    </div>
    <p class="row-nota">{grupo.prs.length} {grupo.prs.length === 1 ? "PR" : "PRs"}</p>
  </div>
  <p class="row-text">{grupo.nota}</p>
  <ul class="os-prs">
    {
      grupo.prs.map((pr) => (
        <li>
          <a class="os-pr" href={`https://github.com/${grupo.repo}/pull/${pr.numero}`} target="_blank" rel="noopener">
            <span class="os-num">#{pr.numero}</span>
            <span class="os-titulo">
              {"versao" in pr && <span class="os-versao">{pr.versao}</span>}
              {pr.titulo}
            </span>
            <time class="os-data" datetime={pr.data}>{mesAno(pr.data)}</time>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .os-repo {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.5rem;
  }

  .os-repo-nome {
    gap: 0;
    color: var(--primary);
    font-family: var(--mono);
    font-size: 0.875rem;
  }

  .os-dono {
    color: var(--muted-foreground);
  }

  .os-prs {
    display: flex;
    margin-top: 0.625rem;
    flex-direction: column;
    list-style: none;
  }

  .os-pr {
    display: grid;
    align-items: baseline;
    padding: 0.3125rem 0.5rem;
    margin-inline: -0.5rem;
    border-radius: 0.375rem;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    gap: 0.75rem;
    grid-template-columns: 3.75rem 1fr auto;
    transition: background-color 0.15s, color 0.15s;
  }

  .os-pr:hover {
    background: var(--muted);
    color: var(--primary);
  }

  .os-num,
  .os-data {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .os-data {
    white-space: nowrap;
  }

  .os-titulo {
    min-width: 0;
    text-wrap: pretty;
  }

  .os-versao {
    display: inline-block;
    padding: 0 0.3125rem;
    margin-right: 0.375rem;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    font-family: var(--mono);
    font-size: 0.6875rem;
    line-height: 1.125rem;
    vertical-align: 1px;
  }

  @media (max-width: 30rem) {
    .os-pr {
      grid-template-columns: 3.25rem 1fr;
    }

    .os-data {
      display: none;
    }
  }
</style>
