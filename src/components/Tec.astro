---
interface Props {
  item: {
    nome: string;
    icon?: { path: string };
    logo?: { viewBox: string; body: string };
  };
  label?: boolean;
}

const { item, label = false } = Astro.props;
---

<span class="tec" title={item.nome}>
  {
    item.icon ? (
      <svg class="tec-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d={item.icon.path} />
      </svg>
    ) : (
      <svg class="tec-icon" viewBox={item.logo?.viewBox} aria-hidden="true" set:html={item.logo?.body} />
    )
  }
  {label ? <span>{item.nome}</span> : <span class="sr-only">{item.nome}</span>}
</span>

<style>
  .tec {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    white-space: nowrap;
    /* transform: o magnetismo do ponteiro escreve direto no style */
    transition: color 0.15s, transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .tec:hover {
    color: var(--primary);
  }

  .tec-icon {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
    fill: currentColor;
  }

</style>
