---
interface Props {
  item: { id: string; nome: string };
  label?: boolean;
}

const { item, label = false } = Astro.props;
---

<span class="tec" title={item.nome}>
  <svg class="tec-icon" aria-hidden="true"><use href={`#i-${item.id}`} /></svg>
  {label ? <span>{item.nome}</span> : <span class="sr-only">{item.nome}</span>}
</span>

<style>
  .tec {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    white-space: nowrap;
    /* transform: o magnetismo do ponteiro escreve direto no style */
    transition: color 0.15s, transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .tec:hover {
    color: var(--primary);
  }

  .tec-icon {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
    fill: currentColor;
  }

</style>
