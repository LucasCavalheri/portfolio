---
import { legivel, FUNDO_CLARO, FUNDO_ESCURO } from "../data/cor";
import type { Tecnologia } from "../data/tec";

interface Props {
  item: Tecnologia;
  label?: boolean;
}

const { item, label = false } = Astro.props;

// simple-icons entrega o hex sem cerquilha
const marca = item.hex.startsWith("#") ? item.hex : `#${item.hex}`;
---

<a
  class="tec"
  href={item.url}
  target="_blank"
  rel="noopener"
  data-tec={item.nome}
  data-sobre={item.sobre}
  aria-label={`${item.nome}: ${item.sobre}`}
  style={`--marca-escura: ${legivel(marca, FUNDO_ESCURO)}; --marca-clara: ${legivel(marca, FUNDO_CLARO)}`}
>
  <svg class="tec-icon" aria-hidden="true"><use href={`#i-${item.id}`} /></svg>
  {label ? <span>{item.nome}</span> : <span class="sr-only">{item.nome}</span>}
</a>

<style>
  .tec {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    white-space: nowrap;
    /* transform: o magnetismo do ponteiro escreve direto no style */
    transition: color 0.15s, transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tec:hover,
  .tec:focus-visible {
    color: var(--primary);
  }

  .tec-icon {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
    fill: currentColor;
    transition: color 0.25s ease;
  }

  /* No hover o ícone assume a cor da marca, já ajustada ao fundo do tema */
  :global(:root[data-theme="dark"]) .tec:hover .tec-icon,
  :global(:root[data-theme="dark"]) .tec:focus-visible .tec-icon {
    color: var(--marca-escura);
  }

  :global(:root[data-theme="light"]) .tec:hover .tec-icon,
  :global(:root[data-theme="light"]) .tec:focus-visible .tec-icon {
    color: var(--marca-clara);
  }
</style>
