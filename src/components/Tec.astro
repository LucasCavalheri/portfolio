---
interface Props {
  item: { nome: string; icon?: { path: string }; img?: string; mark?: string };
  label?: boolean;
}

const { item, label = false } = Astro.props;
---

<span class="tec" title={item.nome}>
  {
    item.icon ? (
      <svg class="tec-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d={item.icon.path} />
      </svg>
    ) : item.img ? (
      <img class="tec-img" src={item.img} alt="" width="14" height="14" loading="lazy" />
    ) : (
      <span class="tec-mark" aria-hidden="true">{item.mark}</span>
    )
  }
  {label ? <span>{item.nome}</span> : <span class="sr-only">{item.nome}</span>}
</span>

<style>
  .tec {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    white-space: nowrap;
    transition: color 0.15s;
  }

  .tec:hover {
    color: var(--primary);
  }

  .tec-icon {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
    fill: currentColor;
  }

  /* Marca com cores próprias (logo multicolor) */
  .tec-img {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
    object-fit: contain;
  }

  .tec-mark {
    display: inline-flex;
    min-width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
    padding-inline: 2px;
    align-items: center;
    justify-content: center;
    border: 1px solid currentColor;
    border-radius: 3px;
    font-family: var(--mono);
    font-size: 0.5625rem;
    line-height: 1;
  }
</style>
