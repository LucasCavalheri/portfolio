---
import Tec from "./Tec.astro";
import type { projetosAbertos } from "../data/conteudo";
import { nomeTransicao } from "../data/transicao";

interface Props {
  projeto: (typeof projetosAbertos)[number];
  // em /open-source o nome recebe a linha da home na navegação
  transicao?: boolean;
  [atributo: string]: unknown;
}

const { projeto, transicao = false, ...resto } = Astro.props;
const nome = transicao && projeto.repo ? nomeTransicao(new URL(projeto.repo).pathname.slice(1)) : undefined;
---

<div class="row" {...resto}>
  <p class="row-meta">
    {projeto.tipo}{projeto.licenca && ` · licença ${projeto.licenca}`}
  </p>
  <div class="row-top">
    <h3 style={nome && `view-transition-name: ${nome}`}>{projeto.nome}</h3>
    <div class="row-links">
      {projeto.site && (
        <a class="link link-xs" href={projeto.site} target="_blank" rel="noopener">
          <span>Site</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M17 7H9M17 7v8" /></svg>
        </a>
      )}
      {projeto.repo && (
        <a class="link link-xs" href={projeto.repo} target="_blank" rel="noopener">
          <span>GitHub</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M17 7H9M17 7v8" /></svg>
        </a>
      )}
      {projeto.codigoPrivado && <span class="row-nota">código privado</span>}
    </div>
  </div>
  <p class="row-text">{projeto.descricao}</p>
  <div class="tec-row">
    {projeto.tec.map((item) => <Tec item={item} />)}
  </div>
</div>
