---
const itens = [
  { href: "/#inicio", rotulo: "início" },
  { href: "/#projetos", rotulo: "projetos" },
  { href: "/#experiencia", rotulo: "experiência" },
  { href: "/#atividade", rotulo: "atividade", opcional: true },
  { href: "/#contato", rotulo: "contato" },
];
---

<header class="container topbar reveal-top">
  <nav id="nav" aria-label="Navegação principal">
    {
      itens.map((item) => (
        <a class:list={["nav-link", item.opcional && "nav-opcional"]} href={item.href}>
          {item.rotulo}
        </a>
      ))
    }
    <span class="nav-line" aria-hidden="true"></span>
  </nav>
  <button id="theme-toggle" type="button" aria-label="Alternar tema" aria-pressed="true">
    <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
    <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
    </svg>
  </button>
</header>

<style>
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2.5rem;
  }

  .topbar nav {
    position: relative;
    display: flex;
    align-items: center;
    margin-left: -0.625rem;
  }

  /* Sublinhado que desliza entre os itens do menu */
  .nav-line {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1.5px;
    border-radius: 1px;
    background: var(--primary);
    opacity: 0;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), width 0.45s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s;
  }

  .nav-line[data-ready="true"] {
    opacity: 1;
  }

  .nav-link[data-active="true"] {
    color: var(--foreground);
  }

  .topbar nav a {
    padding: 0.25rem 0.625rem;
    border-radius: 0.375rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    transition: color 0.15s;
  }

  .topbar nav a:hover {
    color: var(--foreground);
  }

  #theme-toggle {
    display: inline-flex;
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    color: var(--muted-foreground);
    transition: background-color 0.15s, color 0.15s;
  }

  #theme-toggle:hover {
    background: var(--muted);
    color: var(--foreground);
  }

  #theme-toggle svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.6;
  }

  :root[data-theme="dark"] .icon-sun,
  :root[data-theme="light"] .icon-moon {
    display: none;
  }

  @media (max-width: 30rem) {
    /* Cinco itens não cabem em tela estreita; o gráfico segue acessível pelo scroll */
    .nav-opcional {
      display: none;
    }
  }
</style>
