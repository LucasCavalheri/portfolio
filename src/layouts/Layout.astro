---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="pt-BR" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050505" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://github.com/LucasCavalheri.png?size=512" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.dataset.js = "on";
      try {
        const saved = localStorage.getItem("lucas-theme");
        if (saved === "light") {
          document.documentElement.dataset.theme = "light";
        }
      } catch {}
    </script>
  </head>
  <body>
    <div class="top-fade" aria-hidden="true"></div>
    <slot />
  </body>
</html>

<style is:global>
  :root[data-theme="dark"] {
    --background: #050505;
    --foreground: #fafafa;
    --primary: #e6e6e6;
    --muted: #212121;
    --muted-foreground: #a1a1a1;
    --card: #131313;
    --border: rgba(255, 255, 255, 0.1);
    --ring: #6f6f6f;
    --cell-0: #1c1c1c;
    --cell-1: #40403f;
    --cell-2: #6b6b6a;
    --cell-3: #9c9c9a;
    --cell-4: #e6e6e6;
    color-scheme: dark;
  }

  :root[data-theme="light"] {
    --background: #ffffff;
    --foreground: #0a0a0a;
    --primary: #171717;
    --muted: #f4f4f5;
    --muted-foreground: #71717a;
    --card: #fafafa;
    --border: rgba(0, 0, 0, 0.1);
    --ring: #a1a1aa;
    --cell-0: #ebebee;
    --cell-1: #c6c6cb;
    --cell-2: #96969d;
    --cell-3: #5d5d65;
    --cell-4: #1f1f22;
    color-scheme: light;
  }

  :root {
    --sans: "Geist", ui-sans-serif, system-ui, -apple-system, sans-serif;
    --mono: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --heading: "Instrument Serif", Georgia, serif;
    --radius: 0.625rem;
    --container: 40rem;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    background: var(--background);
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  body {
    display: flex;
    flex-direction: column;
    min-width: 320px;
    min-height: 100dvh;
    overscroll-behavior: none;
    background: var(--background);
    color: var(--foreground);
    font-family: var(--sans);
    font-size: 1rem;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  button {
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  a:focus-visible,
  button:focus-visible {
    border-radius: 4px;
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  ::selection {
    background: var(--primary);
    color: var(--background);
  }

  .sr-only {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Container central de 640px — igual ao view-container */
  .container {
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: 1rem;
  }

  /* Faixa de blur no topo com máscara em gradiente */
  .top-fade {
    position: fixed;
    z-index: 50;
    top: 0;
    left: 0;
    width: 100%;
    height: 3rem;
    pointer-events: none;
    backdrop-filter: blur(24px);
    -webkit-mask-image: linear-gradient(to bottom, #000, transparent);
    mask-image: linear-gradient(to bottom, #000, transparent);
  }

  /* Entrada das seções: sobe 5%, desfoca 12px, aparece */
  @keyframes enter {
    from {
      opacity: 0;
      transform: translate3d(0, 5%, 0);
      filter: blur(12px);
    }
  }

  @keyframes enter-from-top {
    from {
      opacity: 0;
      transform: translate3d(0, -10%, 0);
      filter: blur(12px);
    }
  }

  .reveal {
    animation: enter 0.6s ease both;
    animation-delay: var(--delay, 0s);
  }

  .reveal-top {
    animation: enter-from-top 0.6s ease both;
  }

  /* Título de seção em serifa itálica */
  .section-title {
    color: var(--primary);
    font-family: var(--heading);
    font-size: 1.25rem;
    font-style: italic;
    font-weight: 500;
    line-height: 1.75rem;
  }

  /* Link com sublinhado que cresce e ícone que desliza.
     O sublinhado é background-size (e não ::after) para funcionar
     também quando o link está no meio de um parágrafo. */
  .link {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    background-image: linear-gradient(var(--primary), var(--primary));
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0% 1.5px;
    color: var(--muted-foreground);
    transition: color 0.15s, gap 0.15s, background-size 0.3s;
  }

  .link:hover,
  .link:active {
    gap: 0.25rem;
    background-size: 100% 1.5px;
    color: var(--primary);
  }

  /* Variante para uso dentro de texto corrido */
  .link-text {
    display: inline;
    padding-bottom: 1px;
  }

  .link svg {
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .link-text svg {
    display: inline-block;
    vertical-align: -1px;
  }

  /* Lista com divisores e escurecimento dos vizinhos no hover */
  .rows {
    display: grid;
    grid-template-columns: 1fr;
  }

  .rows > * + * {
    border-top: 1px solid var(--border);
  }

  .row {
    width: 100%;
    padding-block: 1rem;
    transition: opacity 0.05s;
  }

  .rows:hover .row {
    opacity: 0.3;
  }

  .rows .row:hover {
    opacity: 1;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  ::view-transition-old(root) {
    z-index: 1;
  }

  ::view-transition-new(root) {
    z-index: 2;
    animation: theme-reveal 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes theme-reveal {
    from {
      clip-path: circle(0 at var(--theme-x, 50vw) var(--theme-y, 50vh));
    }
    to {
      clip-path: circle(150% at var(--theme-x, 50vw) var(--theme-y, 50vh));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
