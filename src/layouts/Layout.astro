---
interface Props {
  title: string;
  description: string;
  tecnologias?: readonly Tecnologia[];
  comContatos?: boolean;
}

import { contatos } from "../data/contato";
import { site } from "../data/site";
import type { Tecnologia } from "../data/tec";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollTop from "../components/ScrollTop.astro";
import SpriteTec from "../components/SpriteTec.astro";
// Fontes servidas pelo próprio domínio: uma origem a menos no caminho crítico
import "@fontsource-variable/geist";
import "@fontsource/geist-mono/400.css";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";

const { title, description, tecnologias = [], comContatos = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imagemSocial = new URL("/og.png", Astro.site);

// Identidade legível por máquina: Person (quem sou), ProfessionalService
// (o serviço que presto, com contato e endereço) e WebSite, num só @graph.
const enderecoPostal = {
  "@type": "PostalAddress",
  addressLocality: site.cidade,
  addressRegion: site.estado,
  addressCountry: site.pais,
};

const pessoa = {
  "@type": "Person",
  "@id": `${site.url}/#lucas`,
  name: site.nome,
  alternateName: site.nomeCompleto,
  description: site.descricao,
  url: site.url,
  image: imagemSocial.href,
  jobTitle: site.cargo,
  email: `mailto:${site.email}`,
  telephone: site.telefone,
  knowsLanguage: ["pt-BR", "en"],
  knowsAbout: [
    "TypeScript",
    "JavaScript",
    "React",
    "Next.js",
    "Node.js",
    "NestJS",
    "Fastify",
    "PostgreSQL",
  ],
  address: enderecoPostal,
  worksFor: {
    "@type": "Organization",
    name: site.empresaAtual.nome,
    url: site.empresaAtual.url,
  },
  sameAs: Object.values(site.redes),
};

const servico = {
  // Organization junto de ProfessionalService: é o tipo que os validadores
  // procuram para conferir contato e endereço
  "@type": ["Organization", "ProfessionalService"],
  "@id": `${site.url}/#servico`,
  name: `${site.nome}, desenvolvimento web`,
  description: site.descricao,
  url: site.url,
  image: imagemSocial.href,
  founder: { "@id": `${site.url}/#lucas` },
  address: enderecoPostal,
  areaServed: { "@type": "Country", name: "Brasil" },
  availableLanguage: ["pt-BR", "en"],
  knowsAbout: pessoa.knowsAbout,
  contactPoint: [
    {
      "@type": "ContactPoint",
      contactType: "sales",
      email: site.email,
      telephone: site.telefone,
      availableLanguage: ["pt-BR", "en"],
      areaServed: "BR",
    },
    {
      "@type": "ContactPoint",
      contactType: "technical support",
      email: site.email,
      availableLanguage: ["pt-BR", "en"],
    },
  ],
  sameAs: Object.values(site.redes),
};

const website = {
  "@type": "WebSite",
  "@id": `${site.url}/#site`,
  name: `${site.nome} — ${site.cargo}`,
  description: site.resumoCurto,
  url: site.url,
  inLanguage: "pt-BR",
  publisher: { "@id": `${site.url}/#lucas` },
};

const api = {
  "@type": "WebAPI",
  "@id": `${site.url}/#api`,
  name: `API pública de ${site.nome}`,
  description:
    "Perfil, projetos, experiência, stack e contato em JSON, somente leitura, sem autenticação. Especificação OpenAPI 3.1.",
  url: `${site.url}/desenvolvedores`,
  documentation: `${site.url}/desenvolvedores`,
  provider: { "@id": `${site.url}/#lucas` },
  termsOfService: `${site.url}/desenvolvedores#limites`,
  potentialAction: {
    "@type": "ConsumeAction",
    target: `${site.url}/api/v1/index.json`,
  },
};

const dadosEstruturados = {
  "@context": "https://schema.org",
  "@graph": [pessoa, servico, website, api],
};
---

<!doctype html>
<html lang="pt-BR" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050505" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="api-catalog" href="/.well-known/api-catalog" />
    <link rel="service-desc" type="application/json" href="/openapi.json" />
    <link rel="service-doc" href="/desenvolvedores" />
    <link rel="describedby" href="/llms.txt" />
    <link rel="ai-catalog" href="/.well-known/ai-catalog.json" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lucas Cavalheri" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagemSocial} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lucas Cavalheri, Desenvolvedor Web Full Stack Pleno" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagemSocial} />
    <script type="application/ld+json" set:html={JSON.stringify(dadosEstruturados)} is:inline />
    <script is:inline>
      document.documentElement.dataset.js = "on";
      try {
        const saved = localStorage.getItem("lucas-theme");
        if (saved === "light") {
          document.documentElement.dataset.theme = "light";
        }
      } catch {}
    </script>
    <script is:inline>
      (() => {
        if (window.__lucasWebmcp) return;
        const jsonApi = (rota) =>
          fetch(rota).then((r) => {
            if (!r.ok) throw new Error(String(r.status));
            return r.json();
          });
        const tools = [
          {
            name: "get_perfil",
            description: "Identidade, cargo, localização e disponibilidade de Lucas Cavalheri.",
            inputSchema: { type: "object", properties: {} },
            execute: () => jsonApi("/api/v1/perfil.json"),
          },
          {
            name: "get_projetos",
            description: "Projetos com tipo, ano, stack e links.",
            inputSchema: { type: "object", properties: {} },
            execute: () => jsonApi("/api/v1/projetos.json"),
          },
          {
            name: "get_experiencia",
            description: "Cargos, empresas, períodos e stack.",
            inputSchema: { type: "object", properties: {} },
            execute: () => jsonApi("/api/v1/experiencia.json"),
          },
          {
            name: "get_stack",
            description: "Tecnologias agrupadas por categoria.",
            inputSchema: { type: "object", properties: {} },
            execute: () => jsonApi("/api/v1/stack.json"),
          },
          {
            name: "get_contato",
            description: "E-mail, WhatsApp e demais canais de Lucas Cavalheri.",
            inputSchema: { type: "object", properties: {} },
            execute: () => jsonApi("/api/v1/contato.json"),
          },
        ];
        const ctx = navigator.modelContext || document.modelContext || window.modelContext;
        if (!ctx) return;
        window.__lucasWebmcp = true;
        if (typeof ctx.provideContext === "function") {
          try {
            ctx.provideContext({ tools });
          } catch (e) {}
        }
        if (typeof ctx.registerTool === "function") {
          for (const tool of tools) {
            try {
              ctx.registerTool(tool);
            } catch (e) {}
          }
        }
      })();
    </script>
  </head>
  <body>
    <SpriteTec tecnologias={tecnologias} contatos={comContatos ? contatos : []} />
    <div class="top-fade" aria-hidden="true"></div>
    <Header />
    <slot />
    <Footer />
    <ScrollTop />
    <div class="tec-tip" id="tec-tip" role="tooltip" aria-hidden="true" data-visible="false">
      <strong data-titulo></strong>
      <span data-texto></span>
      <a class="tec-tip-acao" data-acao href="#" target="_blank" rel="noopener" tabindex="-1">
        abrir site ↗
      </a>
    </div>
    <script>
      import "../scripts/tema";
      import "../scripts/reveal";
      import "../scripts/nav";
      import "../scripts/scroll-top";
      import "../scripts/magnetismo";
      import "../scripts/tec-tooltip";
    </script>
    <script>
      import "../scripts/webmcp";
    </script>
  </body>
</html>

<style is:global>
  :root[data-theme="dark"] {
    --background: #050505;
    --foreground: #fafafa;
    --primary: #e6e6e6;
    --muted: #212121;
    --muted-foreground: #a1a1a1;
    --card: #131313;
    --border: rgba(255, 255, 255, 0.1);
    --ring: #6f6f6f;
    --cell-0: #1c1c1c;
    --cell-1: #40403f;
    --cell-2: #6b6b6a;
    --cell-3: #9c9c9a;
    --cell-4: #e6e6e6;
    --brilho: rgba(255, 255, 255, 0.14);
    color-scheme: dark;
  }

  :root[data-theme="light"] {
    --background: #ffffff;
    --foreground: #0a0a0a;
    --primary: #171717;
    --muted: #f4f4f5;
    --muted-foreground: #71717a;
    --card: #fafafa;
    --border: rgba(0, 0, 0, 0.1);
    --ring: #a1a1aa;
    --cell-0: #ebebee;
    --cell-1: #c6c6cb;
    --cell-2: #96969d;
    --cell-3: #5d5d65;
    --cell-4: #1f1f22;
    --brilho: rgba(0, 0, 0, 0.07);
    color-scheme: light;
  }

  :root {
    --sans: "Geist Variable", ui-sans-serif, system-ui, -apple-system, sans-serif;
    --mono: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    --heading: "Instrument Serif", Georgia, serif;
    --radius: 0.625rem;
    --container: 40rem;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    background: var(--background);
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  body {
    display: flex;
    flex-direction: column;
    min-width: 320px;
    min-height: 100dvh;
    overscroll-behavior: none;
    background: var(--background);
    color: var(--foreground);
    font-family: var(--sans);
    font-size: 1rem;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  button {
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  a:focus-visible,
  button:focus-visible {
    border-radius: 4px;
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  ::selection {
    background: var(--primary);
    color: var(--background);
  }

  .sr-only {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Container central de 640px — igual ao view-container */
  .container {
    width: 100%;
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: 1rem;
  }

  /* Faixa de blur no topo com máscara em gradiente */
  .top-fade {
    position: fixed;
    z-index: 50;
    top: 0;
    left: 0;
    width: 100%;
    height: 3rem;
    pointer-events: none;
    backdrop-filter: blur(24px);
    -webkit-mask-image: linear-gradient(to bottom, #000, transparent);
    mask-image: linear-gradient(to bottom, #000, transparent);
  }

  /* Entrada das seções: sobe 5%, desfoca 12px, aparece */
  @keyframes enter {
    from {
      opacity: 0;
      transform: translate3d(0, 5%, 0);
      filter: blur(12px);
    }
  }

  @keyframes enter-from-top {
    from {
      opacity: 0;
      transform: translate3d(0, -10%, 0);
      filter: blur(12px);
    }
  }

  .reveal {
    animation: enter 0.6s ease both;
    animation-delay: var(--delay, 0s);
  }

  .reveal-top {
    animation: enter-from-top 0.6s ease both;
  }

  /* Título de seção em serifa itálica */
  .section-title {
    color: var(--primary);
    font-family: var(--heading);
    font-size: 1.25rem;
    font-style: italic;
    font-weight: 500;
    line-height: 1.75rem;
  }

  /* Link com sublinhado que cresce e ícone que desliza.
     O sublinhado é background-size (e não ::after) para funcionar
     também quando o link está no meio de um parágrafo. */
  .link {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    background-image: linear-gradient(var(--primary), var(--primary));
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 0% 1.5px;
    color: var(--muted-foreground);
    transition: color 0.15s, gap 0.15s, background-size 0.3s;
  }

  .link:hover,
  .link:active {
    gap: 0.25rem;
    background-size: 100% 1.5px;
    color: var(--primary);
  }

  /* Variante para uso dentro de texto corrido */
  .link-text {
    display: inline;
    padding-bottom: 1px;
  }

  .link svg {
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .link-text svg {
    display: inline-block;
    vertical-align: -1px;
  }

  /* Lista com divisores e escurecimento dos vizinhos no hover */
  .rows {
    display: grid;
    grid-template-columns: 1fr;
  }

  .rows > * + * {
    border-top: 1px solid var(--border);
  }

  .row {
    width: 100%;
    padding-block: 1rem;
    transition: opacity 0.05s;
  }

  .rows:hover .row {
    opacity: 0.3;
  }

  .rows .row:hover {
    opacity: 1;
  }

  main {
    padding-block: 3.5rem;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem 0;
    /* A faixa de blur do topo tem 3rem: a âncora para antes dela */
    scroll-margin-top: 4rem;
  }

  .section-head {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.25rem;
  }

  .dot {
    display: inline-block;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .section[data-active="true"] .dot {
    animation: dot-beat 2.4s ease-in-out infinite;
    color: var(--foreground);
  }

  @keyframes dot-beat {
    0%,
    100% {
      opacity: 0.35;
      transform: translateY(0) scale(1);
    }
    50% {
      opacity: 1;
      transform: translateY(-1px) scale(1.15);
    }
  }

  .anchor {
    display: inline-flex;
    width: 1.75rem;
    height: 1.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    opacity: 0;
    transition: background-color 0.15s, color 0.15s, opacity 0.15s;
  }

  .section-head:hover .anchor {
    opacity: 1;
  }

  .anchor:hover {
    background: var(--muted);
    color: var(--foreground);
  }

  .button {
    display: inline-flex;
    height: 2rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    padding-inline: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    color: var(--foreground);
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    transition: background-color 0.15s, border-color 0.15s, translate 0.1s;
  }

  .button:hover {
    background: var(--muted);
  }

  .button:active {
    translate: 0 1px;
  }

  .button svg {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
    margin-right: 0.375rem;
  }

  .button .icon-fill {
    fill: currentColor;
  }

  .button .icon-stroke {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .button-primary {
    border-color: transparent;
    background: var(--primary);
    color: var(--background);
  }

  .button-primary:hover {
    background: var(--foreground);
  }

  /* Reveal por scroll: sobe 10px, desfoca 6px, com stagger por item */
  [data-js] [data-anim] {
    opacity: 0;
    transform: translateY(10px);
    filter: blur(6px);
  }

  [data-js] [data-anim][data-in="true"] {
    opacity: 1;
    transform: none;
    filter: none;
    transition:
      opacity 0.5s ease var(--stagger, 0s),
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1) var(--stagger, 0s),
      filter 0.5s ease var(--stagger, 0s);
  }

  .row-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  /* Tipo e ano do projeto, acima do nome */
  .row-meta {
    margin-bottom: 0.125rem;
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }

  /* Substitui o link quando não há código público */
  .row-nota {
    color: var(--muted-foreground);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .row h3 {
    color: var(--primary);
    font-size: 1rem;
    font-weight: 400;
  }

  .row-links {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.375rem;
  }

  .row-text {
    margin-top: 0.25rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .tec-row {
    display: flex;
    margin-top: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.875rem;
  }

  .tec-row-end {
    margin-top: 0;
    justify-content: flex-end;
  }

  .row-at {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .row-date {
    color: var(--muted-foreground);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .row-inline {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .row-inline .row-text {
    margin: 0;
    max-width: 70%;
    text-align: right;
  }

  .link-xs {
    font-size: 0.75rem;
  }

  .link-sm {
    font-size: 0.875rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    justify-items: start;
    gap: 0.5rem;
  }

  .contact-plain {
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    animation: enter 0.6s ease both;
    animation-delay: 0.5s;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.625rem;
  }

  .prose strong {
    color: var(--primary);
    font-weight: 500;
  }

  @media (min-width: 40rem) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 30rem) {
    .row-inline {
      flex-direction: column;
      gap: 0.25rem;
    }

    .row-inline .row-text {
      max-width: 100%;
      text-align: left;
    }

    .tec-row-end {
      margin-top: 0.25rem;
      justify-content: flex-start;
    }
  }

  /* Tooltip das tecnologias */
  .tec-tip {
    position: fixed;
    z-index: 60;
    display: flex;
    max-width: min(18rem, calc(100vw - 2rem));
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--card);
    opacity: 0;
    pointer-events: none;
    translate: 0 -100%;
    transition: opacity 0.18s ease, translate 0.18s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .tec-tip[data-lado="abaixo"] {
    translate: 0 0;
  }

  .tec-tip[data-visible="true"] {
    opacity: 1;
    /* alcançável com o ponteiro: o "abrir site" é um link de verdade */
    pointer-events: auto;
  }

  /* Estende a área sensível sobre o vão até o ícone, senão o hover se
     perde no caminho e o tooltip fecha antes de ser alcançado */
  .tec-tip::after {
    position: absolute;
    right: 0;
    bottom: -0.75rem;
    left: 0;
    height: 0.75rem;
    content: "";
  }

  .tec-tip[data-lado="abaixo"]::after {
    top: -0.75rem;
    bottom: auto;
  }

  .tec-tip[data-visible="true"][data-lado="acima"] {
    translate: 0 calc(-100% - 3px);
  }

  .tec-tip[data-visible="true"][data-lado="abaixo"] {
    translate: 0 3px;
  }

  .tec-tip strong {
    color: var(--primary);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .tec-tip [data-texto] {
    color: var(--muted-foreground);
    font-size: 0.75rem;
    line-height: 1.35;
    text-wrap: pretty;
  }

  .tec-tip-acao {
    width: fit-content;
    margin-top: 0.125rem;
    color: var(--muted-foreground);
    font-size: 0.6875rem;
    opacity: 0.7;
    transition: color 0.15s, opacity 0.15s;
  }

  .tec-tip-acao:hover {
    color: var(--primary);
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
